<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>EduPro — Learn Anything, Faster</title>
  <meta name="description" content="Elegant, responsive landing page." />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
  <style>
    :root{
      --bg: #e5e6eaff;
      --card: #FFFFFF;
      --elev: #EEF1F8;
      --muted: #5B667A;
      --text: #0F172A;

      --brand:  #F6C445;
      --brand-2:#6F3CC2;

      --ok: #22c55e;
      --warn: #f59e0b;
      --danger: #ef4444;

      --ring: rgba(111,60,194,.30);
      --shadow: 0 10px 30px rgba(2,6,23,.10);

      --radius: 16px;
      --radius-lg: 22px;
      --gap: clamp(16px, 2.5vw, 32px);
      --pad: clamp(16px, 4vw, 56px);
      --maxw: 1200px;
    }

    *{box-sizing:border-box}
    html,body{height:100%}
    body{
      margin:0; font-family:Inter,system-ui,-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;
      color:var(--text);
      background:
        linear-gradient(180deg, rgba(14,18,34,.08), transparent 42%),
        radial-gradient(960px 420px at 85% -10%, rgba(111,60,194,.25), transparent 60%),
        radial-gradient(820px 340px at 5% -10%, rgba(246,196,69,.22), transparent 55%),
        var(--bg);
      line-height:1.6;
    }

    a{color:inherit; text-decoration:none}
    img{max-width:100%; display:block}
    .container{width:100%; max-width:var(--maxw); margin-inline:auto; padding-inline:var(--pad)}

    .btn{
      display:inline-flex; align-items:center; gap:.6rem;
      padding:.9rem 1.2rem; background:var(--brand); color:#1a1a1a;
      border-radius:12px; font-weight:600; border:1px solid rgba(0,0,0,.05);
      box-shadow:var(--shadow); transition:.2s ease
    }
    .btn:hover{transform:translateY(-2px); box-shadow:0 14px 40px rgba(246,196,69,.35)}
    .btn.ghost{
      background:#ffffff; color:var(--text);
      border-color:rgba(111,60,194,.22)
    }

    .badge{
      display:inline-flex; align-items:center; gap:.5rem; padding:.35rem .6rem;
      border:1px solid rgba(111,60,194,.25); border-radius:999px;
      color:#5E3E9E; font-weight:600; font-size:.8rem; background:#F4ECFF
    }

    header{
      position:sticky; top:0; z-index:40;
      background:rgba(255,255,255,.94);
      backdrop-filter:saturate(140%) blur(6px);
      border-bottom:1px solid rgba(111,60,194,.16)
    }
    .nav{display:flex; align-items:center; justify-content:space-between; padding:.7rem var(--pad)}
    .brand{display:flex; align-items:center; gap:.75rem}
    .brand .logo{
      width:36px; height:36px; border-radius:10px;
      background:conic-gradient(from 220deg at 50% 50%, var(--brand-2) 0 62%, var(--brand) 62% 100%);
      box-shadow:0 8px 18px rgba(111,60,194,.18), inset 0 0 22px rgba(255,255,255,.65)
    }
    .brand strong{font-weight:800; letter-spacing:.2px}
    .navlinks{display:flex; gap:1rem; align-items:center}
    .navlinks a{color:#364255; padding:.6rem .8rem; border-radius:10px}
    .navlinks a:hover{background:#F1EAFE}
    .hamb{display:none}

    .hero{padding: clamp(54px, 8vw, 110px) 0 var(--pad)}
    .hero-grid{display:grid; grid-template-columns: 1.05fr .95fr; gap:var(--gap); align-items:center}
    .title{font-size: clamp(2rem, 5vw, 3.5rem); line-height:1.1; letter-spacing:-.02em; margin:0 0 1rem}
    .subtitle{color:#475569; font-size: clamp(1rem, 2.1vw, 1.25rem); margin:0 0 2rem}
    .hero-cta{display:flex; gap:.8rem; flex-wrap:wrap}

    .statbar{display:grid; grid-template-columns:repeat(3,1fr); gap:var(--gap); margin-top:2rem}
    .stat{
      padding:1rem; border:1px solid rgba(2,6,23,.08); background:#ffffff; border-radius:14px;
      box-shadow:0 6px 16px rgba(2,6,23,.06)
    }
    .stat strong{font-size:1.8rem}

    section{padding: calc(var(--pad) * 1.2) 0}
    .section-title{font-size: clamp(1.6rem, 3vw, 2.2rem); margin:0 0 1rem}
    .section-sub{color:var(--muted); margin:0 0 2rem}
    .grid-3{display:grid; grid-template-columns:repeat(3,1fr); gap:var(--gap)}
    .feature{
      background:#ffffff; border:1px solid rgba(2,6,23,.10);
      border-radius:var(--radius); padding:1.2rem; box-shadow:0 10px 26px rgba(2,6,23,.06)
    }
    .feature h3{margin:.6rem 0}
    .icon{
      width:42px; height:42px; display:grid; place-items:center; border-radius:10px;
      background:linear-gradient(135deg, rgba(111,60,194,.50), rgba(246,196,69,.35));
      border:1px solid rgba(111,60,194,.25)
    }

    .pricing{display:grid; grid-template-columns:repeat(3,1fr); gap:var(--gap)}
    .plan{
      background:#ffffff; border:1px solid rgba(2,6,23,.10);
      border-radius:var(--radius-lg); padding:1.4rem; position:relative; box-shadow:0 12px 30px rgba(2,6,23,.07)
    }
    .plan.popular{border-color:rgba(111,60,194,.45); box-shadow:0 0 0 2px rgba(111,60,194,.20)}
    .price{font-size:2.2rem; font-weight:800}
    .list{margin:1rem 0; padding:0; list-style:none}
    .list li{margin:.45rem 0; display:flex; gap:.6rem; align-items:center}

    .cta{
      padding: clamp(24px, 4vw, 36px); border-radius:var(--radius-lg);
      background:linear-gradient(90deg, rgba(111,60,194,.20), rgba(246,196,69,.28));
      border:1px solid rgba(2,6,23,.08);
      display:flex; gap:var(--gap); align-items:center; justify-content:space-between
    }

    .faq{max-width:900px; margin-inline:auto}
    details{border:1px solid rgba(2,6,23,.12); background:#ffffff; border-radius:14px; padding:1rem 1.2rem; box-shadow:0 8px 22px rgba(2,6,23,.06)}
    details+details{margin-top:.8rem}
    summary{cursor:pointer; font-weight:700}
    details[open]{box-shadow:0 10px 30px rgba(2,6,23,.08)}

    footer{border-top:1px solid rgba(111,60,194,.16); background:#FCFCFF}
    .fgrid{display:grid; grid-template-columns:2fr repeat(3,1fr); gap:var(--gap)}
    .fgrid ul{list-style:none; padding:0; margin:0}
    .fgrid li{margin:.5rem 0}
    .copyright{color:var(--muted); font-size:.9rem; margin-top:2rem}

    @media (max-width: 1024px){
      .hero-grid{grid-template-columns:1fr}
      .pricing,.grid-3{grid-template-columns:1fr 1fr}
      .fgrid{grid-template-columns:1fr 1fr}
    }
    @media (max-width: 640px){
      .pricing,.grid-3{grid-template-columns:1fr}
      .fgrid{grid-template-columns:1fr}
      .navlinks{display:none}
      .hamb{display:flex; gap:.6rem; align-items:center}
      .mobile{display:none; position:absolute; left:0; right:0; top:64px; background:#ffffff; border-bottom:1px solid rgba(111,60,194,.18); padding:1rem var(--pad)}
      .mobile a{display:block; padding:.8rem 0; color:#364255}
    }
  </style>
</head>
<body>
  <!-- Header -->
  <header>
    <nav class="nav container" aria-label="Primary">
      <a class="brand" href="#">
        <span class="logo" aria-hidden="true"></span>
        <strong>EduPro</strong>
      </a>
      <div class="navlinks" id="navlinks">
        <a href="#features">Features</a>
        <a href="#pricing">Pricing</a>
        <a href="#faq">FAQ</a>
        <!-- NEW: Register button → Symfony route app_register -->
        <a class="btn" href="{{ path('app_register') }}">Register</a>
        <!-- (Optional) keep a separate sign-in link; update to your login route if needed -->
        <a class="btn ghost" href="{{ path('school_setup') }}">Sign in</a>
      </div>
      <button class="hamb btn ghost" id="hamb" aria-controls="mobile-nav" aria-expanded="false">Menu ▾</button>
    </nav>
  </header>

  <!-- Hero -->
  <section class="hero">
    <div class="container hero-grid">
      <div>
        <span class="badge">✨ Fresh palette</span>
        <h1 class="title">Learn anything, faster — with a personal study coach.</h1>
        <p class="subtitle">Master industry-ready skills with hands-on projects, bite-size lessons, and real mentor feedback. Track your progress, collect certificates, and join a global learner community.</p>
        <div class="hero-cta">
          <a class="btn" href="#pricing">Explore courses</a>
          <a class="btn ghost" href="#video" aria-label="Watch how it works">▶️ Watch demo</a>
          <!-- Also offer Register call-to-action here -->
          <a class="btn" href="{{ path('app_register') }}">Register</a>
        </div>
        <div class="statbar">
          <div class="stat"><div>Graduates</div><strong>120k+</strong></div>
          <div class="stat"><div>Avg. rating</div><strong>4.9/5</strong></div>
          <div class="stat"><div>Hiring partners</div><strong>300+</strong></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Features -->
  <section id="features">
    <div class="container">
      <h2 class="section-title">Everything you need to go from beginner → hired</h2>
      <p class="section-sub">Project-based curriculum, adaptive practice, and real humans cheering you on.</p>
      <div class="grid-3">
        <div class="feature">
          <div class="icon">📚</div>
          <h3>Structured paths</h3>
          <p>Curated learning tracks with checklists, timelines, and milestone reviews so you always know what to do next.</p>
        </div>
        <div class="feature">
          <div class="icon">🧠</div>
          <h3>Adaptive practice</h3>
          <p>Smart quizzes that adjust to your level using spaced repetition and memory curves to lock in concepts.</p>
        </div>
        <div class="feature">
          <div class="icon">👩‍🏫</div>
          <h3>Mentor feedback</h3>
          <p>Submit projects and get annotated reviews from vetted mentors with industry experience.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Pricing -->
  <section id="pricing">
    <div class="container">
      <h2 class="section-title">Simple pricing</h2>
      <p class="section-sub">Start free. Upgrade when you’re ready.</p>
      <div class="pricing">
        <div class="plan">
          <span class="badge">Starter</span>
          <div class="price">$0</div>
          <ul class="list">
            <li>✅ 2 courses</li>
            <li>✅ Community access</li>
            <li>⛔ Mentor reviews</li>
          </ul>
          <a class="btn" href="#cta">Get started</a>
        </div>
        <div class="plan popular">
          <span class="badge">Most Popular</span>
          <div class="price">$19<span style="font-size:1rem; color:var(--muted)">/mo</span></div>
          <ul class="list">
            <li>✅ All courses</li>
            <li>✅ Mentor feedback</li>
            <li>✅ Certificates</li>
          </ul>
          <a class="btn" href="#cta">Upgrade</a>
        </div>
        <div class="plan">
          <span class="badge">Teams</span>
          <div class="price">$49<span style="font-size:1rem; color:var(--muted)">/user</span></div>
          <ul class="list">
            <li>✅ Admin dashboard</li>
            <li>✅ Custom tracks</li>
            <li>✅ Priority support</li>
          </ul>
          <a class="btn" href="#cta">Contact sales</a>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section id="faq">
    <div class="container faq">
      <h2 class="section-title">Frequently asked questions</h2>
      <details>
        <summary>How does the free plan work?</summary>
        <p>Sign up and access a limited selection of courses, community events, and weekly challenges. Upgrade anytime to unlock mentor reviews and certificates.</p>
      </details>
      <details>
        <summary>Do I get a certificate?</summary>
        <p>Yes — each path includes assessments and a final project. Pass the requirements to receive a shareable certificate.</p>
      </details>
      <details>
        <summary>Can I cancel anytime?</summary>
        <p>Absolutely. Plans are month-to-month. Cancel in one click from your dashboard.</p>
      </details>
    </div>
  </section>

  <!-- Footer -->
  <footer>
    <div class="container" style="padding: var(--pad) 0">
      <div class="fgrid">
        <div>
          <div class="brand" style="margin-bottom:.5rem">
            <span class="logo" aria-hidden="true"></span>
            <strong>EduPro</strong>
          </div>
          <p style="color:var(--muted)">A modern learning platform for ambitious people.</p>
        </div>
        <div>
          <strong>Product</strong>
          <ul>
            <li><a href="#features">Features</a></li>
            <li><a href="#pricing">Pricing</a></li>
            <li><a href="#faq">Help</a></li>
          </ul>
        </div>
        <div>
          <strong>Company</strong>
          <ul>
            <li><a href="#">About</a></li>
            <li><a href="#">Careers</a></li>
            <li><a href="#">Contact</a></li>
          </ul>
        </div>
        <div>
          <strong>Resources</strong>
          <ul>
            <li><a href="#faq">Help Center</a></li>
            <li><a href="#">Blog</a></li>
            <li><a href="#">Guides</a></li>
          </ul>
        </div>
      </div>
      <div class="copyright">© <span id="year"></span> EduPro, Inc. All rights reserved.</div>
    </div>
  </footer>

  <script>
    // footer year
    const year = document.getElementById('year');
    if (year) year.textContent = new Date().getFullYear();

    // mobile nav
    const hamb = document.getElementById('hamb');
    const mobile = document.getElementById('mobile-nav');
    function closeMobile(){ if(mobile){ mobile.style.display='none'; } if(hamb){ hamb.setAttribute('aria-expanded','false'); } }
    hamb?.addEventListener('click',()=>{
      const open = mobile?.style.display === 'block';
      if (mobile) mobile.style.display = open ? 'none' : 'block';
      hamb.setAttribute('aria-expanded', String(!open));
    });
  </script>
</body>
</html>
