{% extends 'base.html.twig' %}
{% block title %}Configuration de l’établissement{% endblock %}

{% block body %}
<style>
  :root{
    --brand:#4f46e5; --ink:#0f172a; --muted:#67728a;
    --ring:rgba(79,70,229,.25); --glass:rgba(255,255,255,.78);
    --shadow:0 24px 60px rgba(2,6,23,.10); --radius:18px;
  }
  body{
    background:
      radial-gradient(1200px 500px at 80% -10%, rgba(79,70,229,.10), transparent 60%),
      radial-gradient(900px 420px at 10% -10%, rgba(245,158,11,.10), transparent 55%),
      #f6f9fc;
  }
  .page{ max-width:1100px; margin:32px auto; padding:0 22px; }
  .chip{ display:inline-flex; gap:.5rem; padding:.35rem .6rem; border:1px solid rgba(79,70,229,.25);
    color:#4f46e5; border-radius:999px; background:#eef2ff; font-weight:700; }
  .title{ font-size:clamp(1.7rem,3.2vw,2.5rem); margin:.55rem 0 .25rem; letter-spacing:-.02em; }
  .subtitle{ color:var(--muted); }

  .progress-wrap{ display:flex; align-items:center; gap:10px; margin-top:12px; }
  .progress{ height:10px; background:#e8ecf4; border-radius:999px; overflow:hidden; width:240px;
    box-shadow:inset 0 0 0 1px rgba(2,6,23,.05); }
  .progress>span{ display:block; height:100%;
    width: {{ admin_created ? 100 : (otp_pending ? 70 : 35) }}%; background:linear-gradient(90deg,#4f46e5,#60a5fa); }
  .progress-txt{ color:var(--muted); font-size:.92rem; }

  .grid{ display:grid; grid-template-columns: 1fr 1fr; gap:22px; margin-top:26px; }
  @media (max-width: 980px){ .grid{ grid-template-columns:1fr; } }

  .card{ background:var(--glass); backdrop-filter: blur(8px);
    border:1px solid rgba(2,6,23,.08); border-radius:var(--radius); box-shadow:var(--shadow); }
  .card-header{ padding:18px 20px 0; }
  .card-body{ padding:20px; }
  .card h3{ margin:0; font-weight:800; }
  .card p.lead{ color:var(--muted); margin:.4rem 0 0; }

  .form-label{ font-weight:700; color:#182032; }
  .form-control{ border-radius:12px; padding:.8rem .9rem; border:1px solid rgba(2,6,23,.15); background:#fff; }
  .form-control:focus{ border-color:transparent; box-shadow:0 0 0 4px var(--ring); }
  .input-group-text{ border-radius:12px 0 0 12px; border:1px solid rgba(2,6,23,.15); background:#fff; }

  .btn{ border-radius:12px; font-weight:800; letter-spacing:.2px; }
  .btn-primary{ background:#4f46e5; border-color:#4f46e5; }
  .btn-success{ background:#16a34a; border-color:#16a34a; }
  .btn-outline-secondary{ border-color:rgba(2,6,23,.2); }

  .hr{ height:1px; background:#e8ecf4; margin:16px 0; }
  .hint{ color:var(--muted); font-size:.92rem; }

  .logo-preview img{
    height:56px; border-radius:10px; background:#fff; padding:6px;
    border:1px solid rgba(2,6,23,.08); box-shadow:0 6px 18px rgba(2,6,23,.07);
  }
  .locked{ position:relative; }
  .locked::after{
    content:"Terminez l’étape 1 (compte admin) pour continuer";
    position:absolute; inset:0; display:flex; align-items:center; justify-content:center;
    background:rgba(255,255,255,.65); color:#111; font-weight:800; text-align:center;
    border-radius:var(--radius); padding:18px; backdrop-filter: blur(2px);
  }
  .d-none{ display:none!important; }
</style>

<div class="page">
  <span class="chip">⚙️ Configuration — Assistant</span>
  <h1 class="title">Configuration de l’établissement</h1>
  <p class="subtitle">1) Créez l’administrateur · 2) Ajoutez le nom et le logo de l’école · 3) Enregistrez.</p>

  <div class="progress-wrap">
    <div class="progress" role="progressbar" aria-valuenow="{{ admin_created ? 100 : (otp_pending ? 70 : 35) }}"
         aria-valuemin="0" aria-valuemax="100"><span></span></div>
    <span class="progress-txt">
      {{ admin_created ? 'Étape 2/2' : (otp_pending ? 'Étape 1 — code envoyé' : 'Étape 1/2') }}
    </span>
  </div>

  <div class="grid">

    {# LEFT — School (locked until admin is created) #}
    <section class="card {{ admin_created ? '' : 'locked' }}" id="school">
      <div class="card-header">
        <h3>Établissement</h3>
        <p class="lead">Nom et logo utilisés dans l’en-tête, sur les reçus et états.</p>
      </div>
      <div class="card-body">
        {{ form_start(form, {'attr': {'novalidate': 'novalidate', 'enctype':'multipart/form-data'}}) }}
          <div class="mb-3">
            {{ form_label(form.name, "Nom de l’établissement", {'label_attr': {'class':'form-label'}}) }}
            {{ form_widget(form.name, { 'attr': {'class':'form-control form-control-lg', 'placeholder':'Ex. Lycée Al Amal', '{{ admin_created ? "" : "disabled" }}':'' } }) }}
            {{ form_errors(form.name) }}
          </div>

          <div class="mb-2">
            <label class="form-label" for="{{ form.logoFile.vars.id }}">Logo de l’établissement</label>
            {{ form_widget(form.logoFile, {
              'attr': { 'class': 'form-control', 'accept': 'image/png,image/jpeg', 'onchange':'previewLogo(this)', 'disabled': admin_created ? false : true }
            }) }}
            {{ form_errors(form.logoFile) }}
            <div class="hint mt-1">PNG/JPG · 2 Mo max. Fond transparent recommandé.</div>

            {% if current_logo %}
              <div class="logo-preview mt-3">
                <span class="hint d-block mb-1">Logo actuel</span>
                <img id="currentLogo" src="{{ asset('uploads/logos/' ~ current_logo) }}" alt="Logo actuel">
              </div>
            {% endif %}

            <div id="newLogoWrap" class="logo-preview mt-3 d-none">
              <span class="hint d-block mb-1">Aperçu du nouveau logo</span>
              <img id="newLogo" src="" alt="Aperçu logo">
            </div>
          </div>

          <div class="d-flex gap-2 flex-wrap mt-3">
            <button class="btn btn-primary" type="submit" {{ admin_created ? '' : 'disabled' }}>
              <i class="fa-solid fa-floppy-disk me-1"></i> Enregistrer et continuer
            </button>
            <a class="btn btn-outline-secondary" href="{{ path('app_landing') }}">Retour au portail</a>
          </div>
        {{ form_end(form, { render_rest:false }) }}
      </div>
    </section>

    {# RIGHT — Admin account step #}
    <section class="card" id="admin">
      <div class="card-header">
        <h3>Compte administrateur</h3>
        <p class="lead">Créez le 1ᵉʳ administrateur, recevez un code par e-mail, validez.</p>
      </div>
      <div class="card-body">

        {% if admin_created %}
          <div class="alert alert-success mb-3">
            <strong>Super !</strong> Le compte admin <code>{{ admin_email }}</code> est prêt.
            Vous pouvez compléter l’étape 2 à gauche.
          </div>
        {% elseif otp_pending %}
          <div class="alert alert-info mb-3">
            Un code a été envoyé à <strong>{{ admin_email }}</strong>. Saisissez-le ci-dessous pour activer le compte.
          </div>
          <form method="post" action="{{ path('school_setup_admin_verify') }}" novalidate>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('setup_admin_verify') }}">
            <div class="mb-3">
              <label for="otp" class="form-label">Code reçu par e-mail</label>
              <input id="otp" name="otp" class="form-control" placeholder="ex. 123456" required>
            </div>
            <div class="d-flex gap-2">
              <button class="btn btn-success"><i class="fa-solid fa-check me-1"></i> Valider le code</button>
              <a class="btn btn-outline-secondary" href="{{ path('school_setup') }}">Modifier l’adresse</a>
            </div>
            <div class="hint mt-2">Le code expire dans 10 minutes.</div>
          </form>
        {% else %}
          <form method="post" action="{{ path('school_setup_admin_send') }}" novalidate>
            <input type="hidden" name="_csrf_token" value="{{ csrf_token('setup_admin_send') }}">
            <div class="mb-3">
              <label for="admin_email" class="form-label">Email</label>
              <div class="input-group">
                <span class="input-group-text"><i class="fa-solid fa-envelope"></i></span>
                <input id="admin_email" name="email" type="email" class="form-control" placeholder="ex. admin@ecole.tld" required>
              </div>
            </div>

            <div class="mb-3">
              <label for="admin_pwd" class="form-label">Mot de passe</label>
              <div class="input-group">
                <span class="input-group-text"><i class="fa-solid fa-lock"></i></span>
                <input id="admin_pwd" name="password" type="password" minlength="8" class="form-control" placeholder="Au moins 8 caractères" required>
              </div>
            </div>

            <div class="mb-2">
              <label for="admin_pwd2" class="form-label">Confirmation</label>
              <div class="input-group">
                <span class="input-group-text"><i class="fa-solid fa-check-double"></i></span>
                <input id="admin_pwd2" name="password_confirm" type="password" minlength="8" class="form-control" required>
              </div>
            </div>

            <button class="btn btn-success mt-2">
              <i class="fa-solid fa-paper-plane me-1"></i> Envoyer le code
            </button>
            <div class="hint mt-2">Astuce : utilisez une adresse générique (p.ex. <code>admin@…</code>).</div>
          </form>
        {% endif %}

      </div>
    </section>
  </div>
</div>

<script>
  function previewLogo(input){
    const wrap = document.getElementById('newLogoWrap');
    const img  = document.getElementById('newLogo');
    if(!input.files || !input.files[0]){ wrap?.classList.add('d-none'); return; }
    const f = input.files[0];
    if(!/image\/(png|jpeg)/i.test(f.type)){
      alert('Veuillez sélectionner un PNG ou JPG.'); input.value=''; wrap?.classList.add('d-none'); return;
    }
    const rd = new FileReader();
    rd.onload = e => { img.src = e.target.result; wrap?.classList.remove('d-none'); };
    rd.readAsDataURL(f);
  }
</script>
{% endblock %}
