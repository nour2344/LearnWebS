{% extends 'base.html.twig' %}
{% block body %}
<h1>Emplois (fichiers)</h1>
<a class="btn btn-primary" href="{{ path('emplois_upload_new') }}">Nouveau</a>
<table class="table mt-3">
  <tr><th>Classe</th><th>À partir du</th><th>Titre</th><th>Fichier</th><th></th></tr>
  {% for e in emplois %}
    <tr>
      <td>{{ e.classe }}</td>
      <td>{{ e.effectiveFrom|date('Y-m-d') }}</td>
      <td>{{ e.titre }}</td>
      <td>
        {% if e.fileName %}<a target="_blank" href="{{ asset('uploads/timetables/' ~ e.fileName) }}">Voir</a>{% endif %}
      </td>
      <td>
        <a class="btn btn-sm btn-secondary" href="{{ path('emplois_upload_edit', {id:e.id}) }}">Modifier</a>
        <form method="post" action="{{ path('emplois_upload_delete',{id:e.id}) }}" style="display:inline" onsubmit="return confirm('Supprimer ?')">
          <input type="hidden" name="_token" value="{{ csrf_token('del_upload_' ~ e.id) }}">
          <button class="btn btn-sm btn-danger">Supprimer</button>
        </form>
      </td>
    </tr>
  {% endfor %}
</table>
{% endblock %}
