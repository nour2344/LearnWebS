{# templates/etudiant/fiche.html.twig #}
<div class="student-fiche">

  <style>
    /* Font */
    @import url('https://fonts.googleapis.com/css2?family=Poppins:wght@400;600;700&display=swap');

    :root{
      --bg: #f7f9fc;         /* page background */
      --panel: #ffffff;      /* card/table bg */
      --text: #2c3e50;       /* main text */
      --muted:#6b7280;       /* muted text */
      --border:#e5e7eb;      /* borders */
      --brand:#3b82f6;       /* primary (blue-500) */
      --brand-2:#60a5fa;     /* lighter blue */
      --ok:#16a34a;          /* green-600 */
      --bad:#ef4444;         /* red-500 */
      --ring: rgba(59,130,246,.18);
    }

    /* Page */
    .student-fiche{
      background: var(--bg);
      min-height: 100%;
      padding: 28px 16px 56px;
      color: var(--text);
      font-family: 'Poppins', sans-serif;
    }
    .container-wide{ max-width: 1100px; margin: 0 auto; }

    /* Hero */
    .hero{
      display:flex; align-items:center; gap:18px; margin-bottom:22px;
    }
    .avatar{
      width:64px; height:64px; border-radius:50%;
      background: linear-gradient(135deg,var(--brand),var(--brand-2));
      display:grid; place-items:center; font-size:28px; color:white;
      box-shadow: 0 10px 20px rgba(59,130,246,.25);
    }
    .title{
      font-weight:700; font-size: clamp(22px, 2.2vw, 30px); letter-spacing:.2px;
    }
    .hero small{ color:var(--muted); display:block; margin-top:4px; }

    .actions{ margin-left:auto; display:flex; gap:10px; }
    .btn{
      border:1px solid var(--border);
      color: var(--text);
      background: #fff;
      padding:10px 14px; border-radius:10px;
      transition: all .2s; cursor:pointer; text-decoration:none;
      display:inline-flex; align-items:center; gap:8px;
      box-shadow: 0 2px 4px rgba(0,0,0,.04);
    }
    .btn:hover{ border-color:#d1d5db; transform: translateY(-1px); }
    .btn-primary{
      background: var(--brand); color:#fff; border-color: transparent;
    }
    .btn-primary:hover{ filter: brightness(.95); }

    /* Cards */
    .grid{ display:grid; grid-template-columns: 1.2fr .8fr; gap:16px; margin-bottom:18px; }
    @media (max-width: 960px){ .grid{ grid-template-columns:1fr; } }

    .card{
      background: var(--panel);
      border: 1px solid var(--border);
      border-radius: 16px; padding: 18px;
      box-shadow: 0 10px 20px rgba(2,6,23,.04);
    }
    .card h6{
      margin:0 0 12px 0; font-weight:700; letter-spacing:.2px; color: var(--text);
      display:flex; align-items:center; gap:8px; font-size:13px; text-transform: uppercase;
    }

    .kv{ display:grid; grid-template-columns: 170px 1fr; gap:8px 12px; }
    .kv .k{ color:var(--muted); }
    .kv .v{ color:var(--text); }

    /* Table */
    .table-wrap{
      background: var(--panel);
      border:1px solid var(--border);
      border-radius:16px; overflow:hidden;
      box-shadow: 0 10px 20px rgba(2,6,23,.04);
    }
    table{ width:100%; border-collapse: collapse; }
    thead th{
      background: #f1f5f9;
      color: var(--text); font-weight:700; letter-spacing:.2px; text-transform: uppercase;
      font-size:12px; padding:12px 14px; position: sticky; top:0; z-index:2;
      border-bottom:1px solid var(--border);
    }
    tbody td{
      padding:14px; border-bottom:1px dashed var(--border);
      color: var(--text);
    }
    tbody tr:hover{ background: #fafafa; }

    /* Badges */
    .badge{
      font-weight:700; padding:8px 12px; border-radius:999px; font-size:12.5px;
      display:inline-flex; align-items:center; gap:8px;
      border:1px solid transparent;
      box-shadow: 0 0 0 3px var(--ring);
    }
    .b-ok{ background: #e8f8ec; color:#0b7a2f; border-color:#bfe8cc;}
    .b-bad{ background: #ffecec; color:#a32323; border-color:#ffd3d3;}

    .legend{ color:var(--muted); display:flex; gap:10px; align-items:center; margin-top:10px; }
    .chip{ padding:6px 10px; border-radius:999px; font-size:12px; border:1px solid var(--border); background:#fff; }
  </style>

  <div class="container-wide">

    {# Compute a safe back URL: prefer Referer, else provided backRoute, else admin index #}
    {% set backUrl = app.request.headers.get('referer')
      ? app.request.headers.get('referer')
      : (backRoute is defined ? path(backRoute) : path('etudiant_index'))
    %}

    <!-- Header -->
    <div class="hero">
      <div class="avatar" aria-hidden="true">👩‍🎓</div>
      <div>
        <div class="title">Fiche de l’étudiant</div>
        <small>Détails et état des paiements mensuels</small>
      </div>
      <div class="actions">
        <a href="{{ backUrl }}" class="btn">⬅️ Retour</a>
        <button class="btn btn-primary" onclick="window.print()">🖨️ Imprimer</button>
      </div>
    </div>

    <!-- Top cards -->
    <div class="grid">
      <div class="card">
        <h6>🧾 Informations</h6>
        <div class="kv">
          <div class="k">Nom</div>          <div class="v">{{ etudiant.nom }}</div>
          <div class="k">Prénom</div>       <div class="v">{{ etudiant.prenom }}</div>
          <div class="k">Classe</div>       <div class="v">{{ etudiant.classe }}</div>

          <div class="k">Téléphone</div>    <div class="v">{{ etudiant.numTel }}</div>
          <div class="k">Téléphone 2</div>  <div class="v">{{ etudiant.numTel2 ?? '—' }}</div>

          <div class="k">Naissance</div>    <div class="v">{{ etudiant.dateN ? etudiant.dateN|date('d/m/Y') }}</div>
          <div class="k">Inscription</div>  <div class="v">{{ etudiant.dateInscription ? etudiant.dateInscription|date('d/m/Y') }}</div>

          <div class="k">Père</div>         <div class="v">{{ etudiant.nomPere ?? '—' }}</div>
          <div class="k">Mère</div>         <div class="v">{{ etudiant.nomMere ?? '—' }}</div>
        </div>
      </div>

      <div class="card">
        <h6>📅 Période</h6>
        <div style="font-size:16px; font-weight:700;">{{ periodLabel }}</div>
        <div class="legend">
          <span>Légende :</span>
          <span class="chip">✅ Payé</span>
          <span class="chip">⛔ Non payé</span>
        </div>
      </div>
    </div>

    <!-- Months table -->
    <div class="table-wrap">
      <table>
        <thead>
          <tr>
            <th style="width:70%;">Mois</th>
            <th class="text-center">Statut</th>
          </tr>
        </thead>
        <tbody>
          {% for m in months %}
            {% set key = m.format('Y-m') %}
            {% set mm  = m.format('m') %}
            <tr>
              <td style="font-weight:600;">{{ monthLabels[mm] ~ ' ' ~ m.format('Y') }}</td>
              <td style="text-align:center;">
                {% if paidMap[key] is defined %}
                  <span class="badge b-ok">✅ Payé</span>
                {% else %}
                  <span class="badge b-bad">⛔ Non payé</span>
                {% endif %}
              </td>
            </tr>
          {% else %}
            <tr>
              <td colspan="2" style="text-align:center; color:var(--muted); padding:28px;">
                Aucun mois à afficher.
              </td>
            </tr>
          {% endfor %}
        </tbody>
      </table>
    </div>

  </div>
</div>
