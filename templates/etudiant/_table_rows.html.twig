{% set list = etudiants is defined ? etudiants : pagination %}

{% for etudiant in list %}
  <tr>
    <td>{{ etudiant.nom }}</td>
    <td>{{ etudiant.prenom }}</td>
    <td>{{ etudiant.classe }}</td>
    <td>{{ etudiant.dateN ? etudiant.dateN|date('d/m/Y') }}</td>
    <td>{{ etudiant.numTel }}</td>
    <td>{{ etudiant.dateInscription ? etudiant.dateInscription|date('d/m/Y') }}</td>
    <td>
      {# …votre badge de statut paiement… #}
    </td>
    <td>
      <div class="d-flex justify-content-center gap-2">
        {# toggle bulletins visibility (POST + CSRF) #}
        <form method="post"
              action="{{ path('etudiant_toggle_bulletins', { id: etudiant.id }) }}"
              onsubmit="event.stopPropagation();">
          <input type="hidden" name="_token" value="{{ csrf_token('toggle_bulletins_' ~ etudiant.id) }}">
          <button class="btn btn-sm {{ etudiant.bulletinsVisibles ? 'btn-danger' : 'btn-success' }}">
            {{ etudiant.bulletinsVisibles ? 'Masquer bulletins' : 'Afficher bulletins' }}
          </button>
        </form>

        <a href="{{ path('etudiant_edit', {'id': etudiant.id}) }}" class="btn btn-sm btn-edit btn-icon" onclick="event.stopPropagation();">✏️ Modifier</a>
        <form method="post" action="{{ path('etudiant_delete', {'id': etudiant.id}) }}"
              onsubmit="return confirm('Confirmer la suppression ?');"
              onclick="event.stopPropagation();">
          <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ etudiant.id) }}">
          <button class="btn btn-sm btn-delete btn-icon">🗑 Supprimer</button>
        </form>
        <a href="{{ path('bulletin_by_etudiant', {'id': etudiant.id}) }}" class="btn btn-warning" onclick="event.stopPropagation();">📄 Bulletin</a>
      </div>
    </td>
  </tr>
{% else %}
  <tr>
    <td colspan="8" class="text-center">Aucun étudiant trouvé.</td>
  </tr>
{% endfor %}
