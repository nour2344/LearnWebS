{# templates/etudiant/index.html.twig #}
{% extends 'base_module.html.twig' %}

{% block title %}Liste des Étudiants{% endblock %}

{% block module_content %}
<style>
  h1 { font-weight: 700; }
  .table thead th { vertical-align: middle; text-align: center; }
  .table td, .table th { vertical-align: middle; text-align: center; }
  .btn-icon { display: flex; align-items: center; gap: 5px; }
  .btn-add { background-color: #4caf50; color: white; font-weight: bold; }
  .btn-add:hover { background-color: #45a049; }
  .btn-edit { background-color: #2196f3; color: white; }
  .btn-edit:hover { background-color: #1976d2; }
  .btn-delete { background-color: #f44336; color: white; }
  .btn-delete:hover { background-color: #c62828; }
  .bulk-actions .btn { min-width: 210px; }
  @media (max-width: 992px) { .bulk-actions { margin-top: 8px; gap: 8px; } }
  .container { animation: fadeIn 0.3s ease-in-out; }
  @keyframes fadeIn { from { opacity:0; transform: translateY(10px);} to { opacity:1; transform: translateY(0);} }
</style>

<div class="container mt-5">
  <h1 class="mb-4 text-center">📋 Liste des Étudiants</h1>

  {% if overdue is defined and overdue|length > 0 %}
    <div class="alert alert-danger" role="alert">
      ⚠️ {{ overdue|length }} étudiant(s) impayé(s) (mois courant) et en retard.
    </div>
  {% endif %}
  {% if dueSoon is defined and dueSoon|length > 0 %}
    <div class="alert alert-warning" role="alert">
      ⏰ {{ dueSoon|length }} étudiant(s) à régler dans les 7 jours.
    </div>
  {% endif %}

  <div class="mb-3 row align-items-end">
    <div class="col"><input type="text" id="f_nom" class="form-control" placeholder="Nom" autocomplete="off"></div>
    <div class="col"><input type="text" id="f_prenom" class="form-control" placeholder="Prénom" autocomplete="off"></div>
    <div class="col"><input type="text" id="f_classe" class="form-control" placeholder="Classe" autocomplete="off"></div>
  </div>

  <table class="table table-hover table-bordered shadow-sm">
    <thead class="table-dark">
      <tr>
        <th>👤 Nom</th>
        <th>🧍 Prénom</th>
        <th>🏫 Classe</th>
        <th>🎂 Naissance</th>
        <th>📞 Téléphone</th>
        <th>📅 Inscription</th>
        <th>✔️ Statut</th>
        <th>⚙️ Actions</th>
      </tr>
    </thead>

    <tbody id="etudiants_table_body">
      {# Initial render; JS will re-render via AJAX (and inject the Identifiants button) #}
      {% include 'etudiant/_table_rows.html.twig' with { 'etudiants': pagination } %}
    </tbody>
  </table>

  <div class="d-flex justify-content-center gap-4 mt-4">
    <a href="{{ path('home') }}" class="btn btn-add btn-lg">⬅️ Accueil</a>
    <a href="{{ path('etudiant_new') }}" class="btn btn-add btn-lg ms-2">➕ Ajouter un étudiant</a>
  </div>

  <div class="d-flex justify-content-center mt-4">
    {{ knp_pagination_render(pagination) }}
  </div>

  <ul id="students_pager" class="pagination justify-content-center mt-3"></ul>
</div>

{# ---------- Modal to show identifiant & password ---------- #}
<div class="modal fade" id="credModal" tabindex="-1" aria-labelledby="credModalLabel" aria-hidden="true">
  <div class="modal-dialog modal-dialog-centered modal-sm">
    <div class="modal-content">
      <div class="modal-header">
        <h5 class="modal-title" id="credModalLabel">🔑 Identifiants</h5>
        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
      </div>
      <div class="modal-body">
        <div class="small text-muted mb-2" id="credStudentName">—</div>

        <div class="mb-2">
          <div class="form-label m-0">Identifiant</div>
          <div class="input-group">
            <input class="form-control" id="credLoginId" readonly>
            <button class="btn btn-outline-secondary" type="button" id="btnCopyId" title="Copier">📋</button>
          </div>
        </div>

        <div>
          <div class="form-label m-0">Mot de passe</div>
          <div class="input-group">
            <input class="form-control" id="credPassword" readonly>
            <button class="btn btn-outline-secondary" type="button" id="btnCopyPwd" title="Copier">📋</button>
          </div>
          <div class="form-text" id="credHint" style="display:none">Ce mot de passe vient d'être régénéré.</div>
        </div>
      </div>
      <div class="modal-footer d-flex justify-content-between">
        <button class="btn btn-outline-secondary btn-sm" data-bs-dismiss="modal">Fermer</button>
        <button class="btn btn-danger btn-sm" id="btnRegenPwd">Régénérer le mot de passe</button>
      </div>
    </div>
  </div>
</div>
{% endblock %}


{% block javascripts %}
  {{ parent() }}
  <script>
    // Run after the whole page & Bootstrap bundle are fully loaded
    window.addEventListener('load', () => {
      const Modal = window.bootstrap && window.bootstrap.Modal ? window.bootstrap.Modal : null;

      /* ---------- Routes helpers ---------- */
      const SENTINEL = '2147483647';
      const routes = {
        fiche:           '{{ path("etudiant_fiche",           {"id": 2147483647}) }}',
        edit:            '{{ path("etudiant_edit",            {"id": 2147483647}) }}',
        bulletin:        '{{ path("bulletin_by_etudiant",     {"id": 2147483647}) }}',
        toggleBulletins: '{{ path("etudiant_toggle_bulletins",{"id": 2147483647}) }}',
        togglePaiement:  '{{ path("etudiant_toggle_paiement", {"id": 2147483647}) }}',
        creds:           '{{ path("etudiant_creds",           {"id": 2147483647}) }}',
        bulkBulletins:   '{{ path("etudiant_bulk_bulletins") }}'
      };
      function withId(urlTpl, id) { return urlTpl.replace(SENTINEL, String(id)); }

      const fNom    = document.getElementById('f_nom');
      const fPrenom = document.getElementById('f_prenom');
      const fClasse = document.getElementById('f_classe');
      const tbody   = document.getElementById('etudiants_table_body');
      const pager   = document.getElementById('students_pager');

      // Optional bulk buttons
      const btnShow = document.getElementById('btn-show-all');
      const btnHide = document.getElementById('btn-hide-all');
      const CSRF_BULK = '{{ csrf_token("bulk_bulletins") }}';

      // Modal bits
      const credModalEl = document.getElementById('credModal');
      const credModal   = Modal ? Modal.getOrCreateInstance(credModalEl) : null;
      const credName    = document.getElementById('credStudentName');
      const credId      = document.getElementById('credLoginId');
      const credPwd     = document.getElementById('credPassword');
      const credHint    = document.getElementById('credHint');
      const btnRegen    = document.getElementById('btnRegenPwd');
      const btnCopyId   = document.getElementById('btnCopyId');
      const btnCopyPwd  = document.getElementById('btnCopyPwd');
      let credCtx = { id: null, csrf: null };

      let t, currentPage = 1;

      function trigger() { clearTimeout(t); t = setTimeout(() => fetchPage(1), 250); }

      function setBulkEnabled(enabled) {
        if (btnShow) btnShow.disabled = !enabled;
        if (btnHide) btnHide.disabled = !enabled;
      }

      async function bulkToggle(visible) {
        if (!btnShow && !btnHide) return;
        const body = new URLSearchParams({
          _token: CSRF_BULK,
          visible: visible ? '1' : '0',
          nom: fNom.value || '',
          prenom: fPrenom.value || '',
          classe: fClasse.value || ''
        });
        const resp = await fetch(routes.bulkBulletins, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body
        });
        if (!resp.ok) { console.error('bulk error', resp.status); return; }
        fetchPage(currentPage);
      }
      btnShow?.addEventListener('click', () => bulkToggle(true));
      btnHide?.addEventListener('click', () => bulkToggle(false));

      function safeId(v){ const s = String(v ?? '').trim(); return /^\d+$/.test(s) ? s : null; }

      function paymentSwitch(r) {
        const checked  = (r.status && r.status.paidThisMonth) ? 'checked' : '';
        const disabled = (!r.csrf_toggle_paiement || !r.id) ? 'disabled' : '';
        const labelTxt = checked ? 'Payé' : 'Non payé';
        return `
          <div class="form-check form-switch d-inline-flex align-items-center gap-2 m-0">
            <input class="form-check-input sw-pay" type="checkbox" role="switch"
                   ${checked} ${disabled}
                   data-id="${r.id ?? ''}"
                   data-csrf="${r.csrf_toggle_paiement ?? ''}">
            <label class="form-check-label">${labelTxt}</label>
          </div>
        `;
      }

      function rowHtml(r) {
        const sid = safeId(r.id);
        const urlFiche    = sid ? withId(routes.fiche, sid)    : '#';
        const urlEdit     = sid ? withId(routes.edit, sid)     : '#';
        const urlBulletin = sid ? withId(routes.bulletin, sid) : '#';

        const btnLabel = r.bulletinsVisibles ? 'Masquer bulletins' : 'Afficher bulletins';
        const btnClass = r.bulletinsVisibles ? 'btn-danger' : 'btn-success';

        const displayName = `${r.nom ?? ''} ${r.prenom ?? ''}`.trim();

        return `
          <tr class="row-click" data-href="${urlFiche}" style="cursor:pointer">
            <td>${r.nom ?? ''}</td>
            <td>${r.prenom ?? ''}</td>
            <td>${r.classe ?? ''}</td>
            <td>${r.dateN ?? ''}</td>
            <td>${r.numTel ?? ''}</td>
            <td>${r.dateInscription ?? ''}</td>

            <td>${paymentSwitch(r)}</td>

            <td>
              <div class="d-flex justify-content-center gap-2">
                <button
                  class="btn btn-sm ${btnClass} btn-toggle-bulletins"
                  data-id="${sid ?? ''}"
                  data-csrf="${r.csrf_toggle_bulletins ?? ''}"
                  type="button"
                  ${(!sid || !r.csrf_toggle_bulletins) ? 'disabled' : ''}>
                  ${btnLabel}
                </button>

                <button
                  class="btn btn-sm btn-secondary btn-creds"
                  type="button"
                  data-id="${sid ?? ''}"
                  data-csrf="${r.csrf_creds ?? ''}"
                  data-name="${displayName}">
                  🔑 Identifiants
                </button>

                <a href="${urlEdit}" class="btn btn-sm btn-edit btn-icon"${sid ? '' : ' onclick="return false;"'}>✏️ Modifier</a>
                <a href="${urlBulletin}" class="btn btn-warning"${sid ? '' : ' onclick="return false;"'}>📄 Bulletin</a>
              </div>
            </td>
          </tr>
        `;
      }

      function renderPager(page, pages) {
        if (!pager) return;
        if (!pages || pages <= 1) { pager.innerHTML = ''; return; }
        let html = '';
        for (let p=1; p<=pages; p++) {
          html += `<li class="page-item ${p===page?'active':''}">
                     <button class="page-link" data-p="${p}" type="button">${p}</button>
                   </li>`;
        }
        pager.innerHTML = html;
        pager.querySelectorAll('button[data-p]').forEach(btn => {
          btn.addEventListener('click', e => fetchPage(parseInt(e.currentTarget.dataset.p, 10)));
        });
      }

      function attachRowClicks() {
        document.querySelectorAll('tr.row-click').forEach(tr => {
          tr.addEventListener('click', (e) => {
            if (e.target.closest('a,button,input,select,textarea,form,[role="button"]')) return;
            const href = tr.getAttribute('data-href');
            if (href && href !== '#') window.location.href = href;
          });
        });
      }

      function attachAjaxButtons() {
        document.querySelectorAll('.btn-toggle-bulletins').forEach(btn => {
          btn.addEventListener('click', (e) => {
            e.stopPropagation();
            const id   = btn.getAttribute('data-id');
            const csrf = btn.getAttribute('data-csrf');
            if (!id || !csrf) return;

            fetch(withId(routes.toggleBulletins, id), {
              method: 'POST',
              headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'X-Requested-With': 'XMLHttpRequest'
              },
              body: `_token=${encodeURIComponent(csrf)}`
            })
            .then(r => { if (!r.ok) throw new Error('HTTP '+r.status); })
            .then(() => fetchPage(currentPage))
            .catch(console.error);
          });
        });
      }

      function attachAjaxPayment() {
        document.querySelectorAll('.sw-pay').forEach(sw => {
          sw.addEventListener('click', (e) => {
            e.stopPropagation();
            const id   = sw.getAttribute('data-id');
            const csrf = sw.getAttribute('data-csrf');
            if (!id || !csrf) { sw.checked = !sw.checked; return; }

            fetch(withId(routes.togglePaiement, id), {
              method: 'POST',
              headers: {
                'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
                'X-Requested-With': 'XMLHttpRequest'
              },
              body: `_token=${encodeURIComponent(csrf)}`
            })
            .then(r => { if (!r.ok) throw new Error('HTTP ' + r.status); })
            .then(() => fetchPage(currentPage))
            .catch(err => {
              console.error(err);
              sw.checked = !sw.checked;
            });
          });
        });
      }

      // --------- Credentials modal flow ----------
      function attachCredButtons() {
        document.querySelectorAll('.btn-creds').forEach(btn => {
          btn.addEventListener('click', async (e) => {
            e.stopPropagation();
            const id   = btn.getAttribute('data-id');
            const csrf = btn.getAttribute('data-csrf');
            const name = btn.getAttribute('data-name') || 'Étudiant';

            if (!id || !csrf || !credModal) {
              console.warn('Identifiants: token manquant ou Bootstrap non chargé.');
              return;
            }

            credCtx = { id, csrf };
            credName.textContent = name;
            credHint.style.display = 'none';
            credId.value = '';
            credPwd.value = '';

            await loadCreds(false); // show existing creds
            credModal.show();
          });
        });
      }

      async function loadCreds(regen) {
        if (!credCtx.id || !credCtx.csrf) return;
        const body = new URLSearchParams({ _token: credCtx.csrf });
        if (regen) body.set('regen', '1');

        const resp = await fetch(withId(routes.creds, credCtx.id), {
          method: 'POST',
          headers: {
            'Content-Type': 'application/x-www-form-urlencoded; charset=UTF-8',
            'X-Requested-With': 'XMLHttpRequest'
          },
          body
        });
        if (!resp.ok) { console.error('creds HTTP', resp.status); return; }
        const data = await resp.json();

        credId.value  = data.loginId || '';
        credPwd.value = data.password ?? '••••••••';
        credHint.style.display = regen ? 'block' : 'none';
      }

      async function copyToClipboard(inputEl) {
        try {
          if (navigator.clipboard && inputEl.value) {
            await navigator.clipboard.writeText(inputEl.value);
          } else {
            inputEl.select();
            document.execCommand('copy');
          }
        } catch (_) {}
      }
      btnCopyId?.addEventListener('click', () => copyToClipboard(credId));
      btnCopyPwd?.addEventListener('click', () => copyToClipboard(credPwd));
      btnRegen?.addEventListener('click', async () => { await loadCreds(true); });

      /* ---------- Initial bindings ---------- */
      setBulkEnabled(true);
      attachAjaxPayment();
      attachRowClicks();

      fNom.addEventListener('input', trigger);
      fPrenom.addEventListener('input', trigger);
      fClasse.addEventListener('input', trigger);

      // Replace server rows by AJAX-rendered rows (adds the "Identifiants" buttons)
      fetchPage(currentPage);

      function fetchPage(page) {
        currentPage = page;
        const params = new URLSearchParams({
          nom: fNom.value || '',
          prenom: fPrenom.value || '',
          classe: fClasse.value || '',
          page: page
        });

        fetch('{{ path("etudiant_index") }}?' + params.toString(), {
          headers: { 'X-Requested-With': 'XMLHttpRequest' }
        })
        .then(r => { if(!r.ok) throw new Error('HTTP '+r.status); return r.json(); })
        .then(({ rows, page, pages }) => {
          tbody.innerHTML = (rows && rows.length)
            ? rows.map(r => rowHtml(r)).join('')
            : '<tr><td colspan="8" class="text-center">Aucun étudiant trouvé.</td></tr>';

          renderPager(page, pages);
          attachRowClicks();
          attachAjaxButtons();
          attachAjaxPayment();
          attachCredButtons();
          setBulkEnabled(rows && rows.length > 0);
        })
        .catch(console.error);
      }
    });
  </script>
{% endblock %}
