{% extends 'base.html.twig' %}
{% block title %}Grille — {{ emploi.classe }}{% endblock %}

{% block body %}
<style>
  .day-card { border:1px solid #e5e7eb; border-radius:.75rem; padding:1rem; margin-bottom:1rem; background:#fff; }
  .day-header { display:flex; align-items:center; justify-content:space-between; margin-bottom:.5rem; }
  .pill { font-size:.75rem; padding:.25rem .5rem; border-radius:999px; background:#eef2ff; color:#3730a3; text-decoration:none; }
  .pill:hover { background:#e0e7ff; }
  .slot { display:flex; align-items:center; justify-content:space-between; padding:.5rem .75rem; border:1px solid #f1f5f9; border-radius:.5rem; background:#fafafa; }
  .slot + .slot { margin-top:.5rem; }
  .slot-time { font-weight:600; min-width:6.5rem; }
  .slot-matiere { flex:1; margin:0 .75rem; }
  .slot-actions a, .slot-actions form { display:inline-block; }
  .empty { color:#64748b; font-style:italic; }
  .toolbar { display:flex; align-items:center; justify-content:space-between; margin-bottom:1.5rem; }
  .toolbar h2 { margin:0; }
</style>

<div class="container py-4">
  <div class="toolbar">
    <div>
      <h2>Grille — {{ emploi.classe }}</h2>
      <div class="text-muted">
        Applicable dès {{ emploi.effectiveFrom|date('Y-m-d') }}{% if emploi.titre %} — {{ emploi.titre }}{% endif %}
      </div>
    </div>
    <div class="d-flex gap-2">
      <a class="btn btn-secondary" href="{{ path('emplois_grille_index') }}">← Retour</a>
      <a class="btn btn-outline-primary" href="{{ path('emplois_pdf', { emploi: emploi.id }) }}">Télécharger PDF</a>
    </div>
  </div>

  {% set days = {
    'Mon':'Lundi','Tue':'Mardi','Wed':'Mercredi','Thu':'Jeudi',
    'Fri':'Vendredi','Sat':'Samedi','Sun':'Dimanche'
  } %}

  <div class="row">
    {% for code, label in days %}
      <div class="col-12 col-md-6 col-lg-4">
        <div class="day-card">
          <div class="day-header">
            <h5 class="m-0">{{ label }}</h5>
            <a class="pill" href="{{ path('emplois_lignes_new', { emploi: emploi.id }) ~ '?day=' ~ code }}">+ Ajouter</a>
          </div>

          {# Slots for the day (compatible with older Twig) #}
          {% set any = false %}
          {% for l in lignes %}
            {% if l.day == code %}
              {% set any = true %}
              <div class="slot">
                <div class="slot-time">{{ l.startAt|date('H:i') }}–{{ l.endAt|date('H:i') }}</div>
                <div class="slot-matiere">{{ l.matiere }}</div>
                <div class="slot-actions">
                  <a class="btn btn-sm btn-outline-secondary"
                     href="{{ path('emplois_lignes_edit', { emploi: emploi.id, id: l.id }) }}">Modifier</a>
                  <form method="post"
                        action="{{ path('emplois_lignes_delete', { emploi: emploi.id, id: l.id }) }}"
                        onsubmit="return confirm('Supprimer ce créneau ?')" style="display:inline">
                    <input type="hidden" name="_token" value="{{ csrf_token('del_ligne_' ~ l.id) }}">
                    <button class="btn btn-sm btn-outline-danger">Supprimer</button>
                  </form>
                </div>
              </div>
            {% endif %}
          {% endfor %}

          {% if not any %}
            <div class="empty">Aucun créneau.</div>
          {% endif %}
        </div>
      </div>
    {% endfor %}
  </div>
</div>
{% endblock %}
