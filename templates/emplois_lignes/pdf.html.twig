<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <style>
    @page { margin: 16mm; }
    body { font-family: DejaVu Sans, Arial, sans-serif; color:#222; font-size: 12px; }

    .title { font-size: 22px; font-weight: 700; margin: 0 0 4px 0; }
    .subtitle { color:#666; margin: 0 0 14px 0; }

    table { width:100%; border-collapse: collapse; table-layout: fixed; }
    thead th, tbody td { border:1px solid #333; }
    thead th {
      padding: 8px 6px;
      text-align: center;
      font-weight: 700;
      color:#000;
    }
    th.time-col { width: 110px; background:#f5f5f5; }

    /* couleurs jours */
    th.day-mon { background:#cfe4ff; }
    th.day-tue { background:#c7ec7a; }
    th.day-wed { background:#ffe16a; }
    th.day-thu { background:#ffb6a6; }
    th.day-fri { background:#f9b2dc; }
    th.day-sat { background:#fff1a8; }
    th.day-sun { background:#f0e4ff; }

    tbody td { height: 40px; padding: 6px; vertical-align: top; text-align: center; }
    .time-label { font-weight: 700; text-align: center; }
    .matiere { display:block; margin:2px 0; }
    .empty { color:#999; font-style: italic; }
  </style>
</head>
<body>

  <div class="title">Emploi — {{ emploi.classe }}</div>
  <div class="subtitle">
    Applicable dès {{ emploi.effectiveFrom|date('Y-m-d') }}
    {% if emploi.titre %} — {{ emploi.titre }}{% endif %}
  </div>

  <table>
    <thead>
      <tr>
        <th class="time-col">Heures</th>
        {% for code, label in days %}
          {% set headClass =
            code == 'Mon' ? 'day-mon' :
            (code == 'Tue' ? 'day-tue' :
            (code == 'Wed' ? 'day-wed' :
            (code == 'Thu' ? 'day-thu' :
            (code == 'Fri' ? 'day-fri' :
            (code == 'Sat' ? 'day-sat' : 'day-sun'))))) %}
          <th class="{{ headClass }}">{{ label }}</th>
        {% endfor %}
      </tr>
    </thead>
    <tbody>
      {# On parcourt uniquement les créneaux saisis par l’admin, triés par startAt #}
      {% for l in lignes|sort((a,b) => a.startAt <=> b.startAt) %}
        <tr>
          <td class="time-label">{{ l.startAt|date('H:i') }}–{{ l.endAt|date('H:i') }}</td>
          {% for code, label in days %}
            <td>
              {% if l.day == code %}
                <span class="matiere">{{ l.matiere }}</span>
              {% else %}
                &nbsp;
              {% endif %}
            </td>
          {% endfor %}
        </tr>
      {% endfor %}
    </tbody>
  </table>

</body>
</html>
