{% extends 'base_module.html.twig' %}

{% block title %}Liste du Personnel{% endblock %}

{% block module_content %}



<style>

    h1 {
        font-weight: 700;
        color: #2c3e50;
    }

    .table thead th, .table td {
        text-align: center;
        vertical-align: middle;
    }

    .btn-icon {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .btn-add {
        background-color: #4caf50;
        color: white;
        font-weight: bold;
    }

    .btn-add:hover {
        background-color: #43a047;
    }

    .btn-edit {
        background-color: #2196f3;
        color: white;
    }

    .btn-edit:hover {
        background-color: #1976d2;
    }

    .btn-delete {
        background-color: #f44336;
        color: white;
    }

    .btn-delete:hover {
        background-color: #c62828;
    }

    .container {
        animation: fadeIn 0.3s ease-in-out;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="container mt-5">
    <h1 class="mb-4 text-center">👩‍🏫 Liste du Personnel</h1>
 {# Filters #}
  <div class="row g-2 align-items-end mb-3">
    <div class="col-sm-4">
      <label class="form-label" for="f_q">Nom / Prénom</label>
      <input id="f_q" name="q" type="text" class="form-control" placeholder="ex: Ben Ali, Sami…">
    </div>
    <div class="col-sm-3">
      <label class="form-label" for="f_role">Rôle</label>
      <select id="f_role" name="role" class="form-select">
        <option value="">— Tous —</option>
        {# values must match your RolePersonnel enum values #}
        <option value="Professeur">Professeur</option>
        <option value="Secrétaire">Secrétaire</option>
        <option value="Surveillant">Surveillant</option>
        <option value="Administrateur">Administrateur</option>
      </select>
    </div>
  </div>

    <table class="table table-striped table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>👤 Nom</th>
                <th>👤 Prénom</th>
                <th>🏷️ Rôle</th>
                <th>💰 Salaire</th>
                <th>📅 Date de Recrutement</th>
                <th>⚙️ Actions</th>
            </tr>
        </thead>
          <tbody id="personnels_tbody">
      {% include 'personnel/_rows.html.twig' with { personnels: personnels } %}
    </tbody>
  </table>

  <div class="d-flex justify-content-center gap-4 mt-4">
    <a href="{{ path('home') }}" class="btn btn-add btn-lg">⬅️ Accueil</a>
    <a href="{{ path('personnel_new') }}" class="btn btn-add btn-lg">➕ Ajouter un membre du personnel</a>
  </div>

  <div class="d-flex justify-content-center mt-4">
    {{ knp_pagination_render(personnels) }}
  </div>
</div>

<script>
(function () {
  const qEl = document.getElementById('f_q');
  const roleEl = document.getElementById('f_role');
  const tbody = document.getElementById('personnels_tbody');

  let t;
  function debounce(fn){ clearTimeout(t); t = setTimeout(fn, 250); }

  function fetchRows(page = 1) {
    const params = new URLSearchParams();
    if (qEl.value.trim() !== '') params.set('q', qEl.value.trim());
    if (roleEl.value) params.set('role', roleEl.value);
    params.set('page', String(page));

    fetch('{{ path("personnel_index") }}?' + params.toString(), {
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.text())
    .then(html => { tbody.innerHTML = html; })
    .catch(console.error);
  }

  qEl.addEventListener('input', () => debounce(fetchRows));
  roleEl.addEventListener('change', () => fetchRows());
})();
</script>
{% endblock %}
