{% extends 'base_module.html.twig' %}

{% block title %}Liste des Salaires{% endblock %}

{% block module_content %}

<style>
    h1 { font-weight: bold; text-align: center; }
    .table thead th, .table td { text-align: center; vertical-align: middle; }
    .btn-icon { display: flex; align-items: center; gap: 5px; }
    .btn-add { background-color: #4caf50; color: white; font-weight: bold; }
    .btn-add:hover { background-color: #43a047; }
    .btn-edit { background-color: #2196f3; color: white; }
    .btn-edit:hover { background-color: #1976d2; }
    .btn-delete { background-color: #e74c3c; color: white; }
    .btn-delete:hover { background-color: #c0392b; }
    .container { animation: fadeIn 0.3s ease-in-out; }
    @keyframes fadeIn { from { opacity:0; transform: translateY(10px);} to { opacity:1; transform: translateY(0);} }
</style>

<div class="container mt-5">
    <h1 class="mb-4">💼 Liste des Salaires</h1>

    {# Bandeaux de notifications (ne comptent que les impayés si repo corrigé) #}
    {% if overdue is defined and overdue|length > 0 %}
        <div class="alert alert-danger" role="alert">
            ⚠️ {{ overdue|length }} paiement(s) en retard.
        </div>
    {% endif %}
    {% if dueSoon is defined and dueSoon|length > 0 %}
        <div class="alert alert-warning" role="alert">
            ⏰ {{ dueSoon|length }} paiement(s) à régler dans les 7 jours.
        </div>
    {% endif %}
{# 🔎 Filters #}
    <div class="row g-2 align-items-end mb-3">
        <div class="col-sm-3">
            <label class="form-label" for="f_mois">Mois</label>
            <input id="f_mois" name="mois" type="text" class="form-control" placeholder="ex: Janvier 2024">
        </div>
        <div class="col-sm-4">
            <label class="form-label" for="f_personnel">Personnel (nom ou prénom)</label>
            <input id="f_personnel" name="personnel" type="text" class="form-control" placeholder="ex: Ben Ali, Noura…">
        </div>
        <div class="col-sm-3">
            <label class="form-label" for="f_statut">Statut</label>
            <select id="f_statut" name="statut" class="form-select">
                <option value="">— Tous —</option>
                <option value="paye">Payé</option>
                <option value="non">Non payé</option>
            </select>
        </div>
    </div>
    <table class="table table-striped table-bordered shadow-sm mt-3">
        <thead class="table-dark">
            <tr>
                <th>📅 Mois</th>
                <th>💰 Montant</th>
                <th>📆 Date de Paiement</th>
                <th>👤 Personnel</th>
                <th>✔️ Statut</th>
                <th>⚙️ Actions</th>
            </tr>
        </thead>
         <tbody id="salaires_tbody">
            {% include 'salaire/_rows.html.twig' with { salaires: salaires } %}
        </tbody>
    </table>

    <div class="d-flex justify-content-center gap-4 mt-4">
        <a href="{{ path('home') }}" class="btn btn-add btn-lg">⬅️ Accueil</a>
        <a href="{{ path('salaire_new') }}" class="btn btn-add btn-lg">➕ Ajouter un Salaire</a>
    </div>

    <div class="d-flex justify-content-center mt-4">
        {{ knp_pagination_render(salaires) }}
    </div>
</div>

<script>
(function () {
  const moisEl = document.getElementById('f_mois');
  const persEl = document.getElementById('f_personnel');
  const statEl = document.getElementById('f_statut');
  const tbody  = document.getElementById('salaires_tbody');

  let t;
  function debounce(fn){ clearTimeout(t); t = setTimeout(fn, 250); }

  function fetchRows(page = 1) {
    const params = new URLSearchParams();
    if (moisEl.value.trim() !== '') params.set('mois', moisEl.value.trim());
    if (persEl.value.trim() !== '') params.set('personnel', persEl.value.trim());
    if (statEl.value !== '') params.set('statut', statEl.value);
    params.set('page', String(page));

    fetch('{{ path("salaire_index") }}?' + params.toString(), {
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
    .then(r => r.text())
    .then(html => { tbody.innerHTML = html; })
    .catch(console.error);
  }

  moisEl.addEventListener('input', () => debounce(fetchRows));
  persEl.addEventListener('input', () => debounce(fetchRows));
  statEl.addEventListener('change', () => fetchRows());
})();
</script>
{% endblock %}
