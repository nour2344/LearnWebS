<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>Impression Bulletin</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 40px;
        }
        h2 {
            text-align: center;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 30px;
        }
        th, td {
            border: 1px solid #555;
            padding: 8px;
            text-align: center;
        }
        .btn-print {
            display: block;
            margin: 30px auto;
            text-align: center;
            font-size: 16px;
            padding: 10px 25px;
            background-color: #5a189a;
            color: white;
            border: none;
            border-radius: 5px;
            cursor: pointer;
        }
        @media print {
            .btn-print {
                display: none;
            }
        }
    </style>
</head>
<body>
    <h2>📄 Bulletin de {{ etudiant.nom }} {{ etudiant.prenom }}</h2>

    <table>
        <thead>
            <tr>
                <th>Matière</th>
                <th>Note</th>
                <th>Date</th>
                <th>Semestre</th>
            </tr>
        </thead>
        <tbody>
            {% for note in bulletins %}
                <tr>
                    <td>{{ note.matiere }}</td>
                    <td>{{ note.note }}</td>
                    <td>{{ note.date|date('d/m/Y') }}</td>
                    <td>{{ note.semestre }}</td>
                </tr>
            {% endfor %}
        </tbody>
    </table>

    <button class="btn-print" onclick="window.print()">🖨️ Imprimer</button>
</body>
</html>
