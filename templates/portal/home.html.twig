{% extends 'base.html.twig' %}
{% block title %}Menu Principal{% endblock %}

{% block body %}
<style>
  :root{
    --brand: {{ (setting and setting.primaryColor) ? setting.primaryColor : '#6F3CC2' }};
  }
  body{
    background:
      linear-gradient(180deg, rgba(14,18,34,.06), transparent 42%),
      radial-gradient(980px 420px at 85% -10%, rgba(111,60,194,.18), transparent 60%),
      radial-gradient(820px 340px at 5% -10%, rgba(246,196,69,.20), transparent 55%),
      #e5e6ea;
  }
  .welcome-box {
    max-width: 700px; background: #fff; margin: 40px auto 20px; padding: 25px 30px;
    border-radius: 20px; box-shadow: 0 10px 30px rgba(0,0,0,.08); text-align: center;
  }
  .grid-container { display:flex; flex-wrap:wrap; justify-content:center; gap:30px;
    padding:30px 50px; max-width:1100px; margin:0 auto; }
  .card { background:#fff; border-radius:20px; padding:40px 30px; width:200px; height:200px;
    text-align:center; box-shadow:0 10px 25px rgba(0,0,0,.1); transition:.2s ease; cursor:pointer;
    text-decoration:none; color:#333; display:flex; flex-direction:column; justify-content:center; align-items:center;
    border:1px solid rgba(2,6,23,.08);
  }
  .card:hover { transform:translateY(-6px); box-shadow:0 15px 30px rgba(0,0,0,.15); }
  .card span.icon { font-size:3rem; margin-bottom:12px; }
  .card span.text { font-size:1.1rem; font-weight:700; letter-spacing:.3px; }
  .dashboard-card { background:linear-gradient(135deg, var(--brand), #F6C445); color:#111;
    border:none; max-width:420px; }
  .academic-year { position:absolute; top:20px; left:30px; font-weight:800; color:#333; }
</style>

<div class="academic-year">
  {{ "now"|date("Y") }}/{{ ("now"|date("Y") + 1) }}
</div>

<div class="welcome-box">
  <h2 style="margin:0 0 6px">
    {{ setting and setting.name ? setting.name : 'Votre établissement' }}
  </h2>
  <p style="margin:0;color:#666">
    Bienvenue sur votre portail. Utilisez les tuiles ci-dessous pour naviguer.
  </p>
</div>

<div>
  <a href="{{ path('app_dashboard') }}" class="card dashboard-card">
    <span class="icon">📊</span>
    <span class="text">Tableau de bord administratif</span>
  </a>
</div>

<div class="grid-container">
  <a href="{{ path('etudiant_index') }}" class="card"><span class="icon">👨‍🎓</span><span class="text">Étudiants</span></a>
  <a href="{{ path('paiement_index') }}" class="card"><span class="icon">💰</span><span class="text">Paiements</span></a>
  <a href="{{ path('personnel_index') }}" class="card"><span class="icon">🧑‍🏫</span><span class="text">Personnel</span></a>
  <a href="{{ path('salaire_index') }}" class="card"><span class="icon">💵</span><span class="text">Salaires</span></a>
  <a href="{{ path('recette_index') }}" class="card"><span class="icon">📥</span><span class="text">Recettes</span></a>
  <a href="{{ path('depense_index') }}" class="card"><span class="icon">📤</span><span class="text">Dépenses</span></a>
  <a href="{{ path('emplois_grille_index') }}" class="card"><span class="icon">🗓️</span><span class="text">Emplois (grille)</span></a>
</div>
{% endblock %}
