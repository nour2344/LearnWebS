{% extends 'base.html.twig' %}

{% block body %}
<!-- Bouton Menu Burger -->
<div id="burger-button" onclick="toggleMenu()">
    ☰ Menu
</div>

<!-- Menu latéral caché -->
<div id="sidebar-menu">
    <a href="{{ path('home') }}">🏠 Accueil</a>
    <a href="{{ path('etudiant_index') }}">👨‍🎓 Étudiants</a>
    <a href="{{ path('paiement_index') }}">💳 Paiements</a>
    <a href="{{ path('personnel_index') }}">👩‍🏫 Personnel</a>
    <a href="{{ path('salaire_index') }}">💰 Salaires</a>
    <a href="{{ path('recette_index') }}">📈 Recettes</a>
    <a href="{{ path('depense_index') }}">📉 Dépenses</a>
    <a href="#" onclick="toggleMenu()">❌ Fermer</a>
</div>

<!-- Masque derrière le menu -->
<div id="overlay" onclick="toggleMenu()"></div>

<!-- Contenu principal -->
<div class="container">
    {% block module_content %}{% endblock %}
</div>

<!-- CSS : à mettre entre <style> -->
<style>
    #burger-button {
        position: fixed;
        top: 20px;
        left: 20px;
        background-color: #333;
        color: white;
        padding: 10px 15px;
        border-radius: 5px;
        z-index: 1001;
        cursor: pointer;
        font-size: 18px;
    }

    #sidebar-menu {
        position: fixed;
        top: 0;
        left: -250px;
        width: 250px;
        height: 100%;
        background-color: #2c3e50;
        color: white;
        padding-top: 60px;
        transition: 0.3s;
        z-index: 1002;
    }

    #sidebar-menu a {
        display: block;
        padding: 15px 25px;
        text-decoration: none;
        color: white;
        transition: 0.2s;
    }

    #sidebar-menu a:hover {
        background-color: #34495e;
    }

    #overlay {
        position: fixed;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.4);
        z-index: 1000;
        display: none;
    }
</style>

<!-- JS -->
<script>
    function toggleMenu() {
        const menu = document.getElementById("sidebar-menu");
        const overlay = document.getElementById("overlay");
        if (menu.style.left === "0px") {
            menu.style.left = "-250px";
            overlay.style.display = "none";
        } else {
            menu.style.left = "0px";
            overlay.style.display = "block";
        }
    }
</script>
{% endblock %}
