{# templates/registration/register.html.twig #}
{% extends 'base.html.twig' %}

{% block title %}Créer un compte administrateur{% endblock %}

{% block body %}
<style>
  .reg-wrap   { max-width: 720px; margin: 48px auto; }
  .reg-card   { border: 0; border-radius: 16px; box-shadow: 0 10px 28px rgba(2,6,23,.06); }
  .reg-title  { font-weight: 800; letter-spacing: .2px; margin-bottom: .25rem; }
  .reg-sub    { color:#6b7280; }
  .form-label { font-weight: 600; }
  .btn-xl     { padding:.9rem 1.2rem; border-radius:12px; font-weight:700; }
</style>

<div class="reg-wrap">
  {% for m in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
      {{ m }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
  {% endfor %}
  {% for m in app.flashes('danger') %}
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
      {{ m }}
      <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Fermer"></button>
    </div>
  {% endfor %}

  <div class="text-center mb-3">
    <div style="font-size:42px">🛡️</div>
    <h1 class="reg-title">Créer un compte administrateur</h1>
    <p class="reg-sub">Renseignez votre e-mail et choisissez un mot de passe.</p>
  </div>

  <div class="card reg-card p-4 p-md-5">
    {{ form_start(registrationForm) }}

      <div class="mb-3">
        {{ form_label(registrationForm.email, 'Email', {'label_attr': {'class':'form-label'}}) }}
        {{ form_widget(registrationForm.email, {
          attr: { class: 'form-control form-control-lg', placeholder: 'ex. admin@ecole.tld' }
        }) }}
        {{ form_errors(registrationForm.email) }}
      </div>

      <div class="mb-3">
        {{ form_label(registrationForm.plainPassword, 'Mot de passe', {'label_attr': {'class':'form-label'}}) }}
        <div class="input-group">
          {{ form_widget(registrationForm.plainPassword, {
            attr: { class: 'form-control form-control-lg', placeholder: 'Au moins 8 caractères', id: 'admin_pwd' }
          }) }}
          <button class="btn btn-outline-secondary" type="button" id="togglePwd" aria-label="Afficher/Cacher">👁</button>
        </div>
        {{ form_errors(registrationForm.plainPassword) }}
      </div>

      {% if registrationForm.agreeTerms is defined %}
        <div class="form-check mt-2 mb-3">
          {{ form_widget(registrationForm.agreeTerms, { attr: { class: 'form-check-input', id: 'agree' } }) }}
          <label class="form-check-label" for="agree">J’accepte les conditions d’utilisation.</label>
          {{ form_errors(registrationForm.agreeTerms) }}
        </div>
      {% endif %}

      <div class="d-grid">
        <button class="btn btn-primary btn-xl">Créer le compte admin</button>
      </div>

    {{ form_end(registrationForm) }}

    <div class="text-center mt-3">
      <small class="text-muted">Vous avez déjà un compte ? <a href="{{ path('app_login') }}">Se connecter</a></small>
    </div>
  </div>
</div>

<script>
  (function () {
    const btn = document.getElementById('togglePwd');
    const inp = document.getElementById('admin_pwd');
    if (btn && inp) {
      btn.addEventListener('click', () => {
        inp.type = (inp.type === 'password') ? 'text' : 'password';
      });
    }
  })();
</script>
{% endblock %}
