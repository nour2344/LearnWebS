{% extends 'base.html.twig' %}

{% block title %}Créer un compte{% endblock %}

{% block body %}
  {% for m in app.flashes('success') %}
    <div class="alert alert-success">{{ m }}</div>
  {% endfor %}

  <ul class="nav nav-tabs mb-3" role="tablist">
    <li class="nav-item" role="presentation">
      <button class="nav-link active" id="staff-tab" data-bs-toggle="tab" data-bs-target="#staff"
              type="button" role="tab" aria-controls="staff" aria-selected="true">
        Inscription Staff
      </button>
    </li>
    <li class="nav-item" role="presentation">
      <button class="nav-link" id="parent-tab" data-bs-toggle="tab" data-bs-target="#parent"
              type="button" role="tab" aria-controls="parent" aria-selected="false">
        Inscription Parent
      </button>
    </li>
  </ul>

  <div class="tab-content">
    <div class="tab-pane fade show active" id="staff" role="tabpanel" aria-labelledby="staff-tab">
      {{ form_start(registrationForm) }}
        {{ form_row(registrationForm.email) }}
        {{ form_row(registrationForm.plainPassword, { label: 'Mot de passe' }) }}
        {{ form_row(registrationForm.agreeTerms) }}
        <button class="btn btn-primary" name="register_staff">Créer le compte staff</button>
      {{ form_end(registrationForm) }}
    </div>

    <div class="tab-pane fade" id="parent" role="tabpanel" aria-labelledby="parent-tab">
      {{ form_start(parentForm) }}
        <div class="card p-3">
          <h5 class="mb-2">Informations du parent</h5>
          {{ form_row(parentForm.fullName) }}
          {{ form_row(parentForm.phone) }}

          <h5 class="mt-3 mb-2">Enfant</h5>
          {{ form_row(parentForm.child) }}

          <h5 class="mt-3 mb-2">Connexion</h5>
          {{ form_row(parentForm.email) }}
          {{ form_row(parentForm.plainPassword) }}

          <div class="mt-3">
            <button class="btn btn-success" name="register_parent">Créer le compte parent</button>
          </div>
        </div>
      {{ form_end(parentForm) }}
    </div>
  </div>
{% endblock %}
