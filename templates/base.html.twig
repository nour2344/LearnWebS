{# templates/base.html.twig #}
<!DOCTYPE html>
<html>
<head>
    <meta charset="UTF-8">
    <title>{% block title %}Gestion Étudiants{% endblock %}</title>

    <!-- Bootstrap + Font Awesome -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        body { background-color: #f6f9fc; color: #000; }
        .btn-main { background-color: #4a90e2; color: #fff; }

        .pagination .page-item.active .page-link { background-color: #4CAF50; border-color: #4CAF50; color: #fff; }
        .pagination .page-link { color: #4CAF50; }
        .pagination .page-link:hover { background-color: #e6f5e6; }

        /* Dark mode */
        body.dark-mode { background-color: #121212 !important; color: #e0e0e0 !important; }
        .navbar.dark-mode, .header.dark-mode { background-color: #1f1f1f !important; }
        .card.dark-mode, .table.dark-mode, .btn-dark-mode, .form-control.dark-mode, .form-select.dark-mode {
            background-color: #2a2a2a !important; color: #e0e0e0 !important; border-color: #444 !important;
        }
        .table-dark th { background-color: #333 !important; color: #fff !important; }

        .btn-toggle-theme { transition: all 0.3s; }
        #themeToggle { z-index: 9999; }

        /* Notifications */
        .notification-bell { position: relative; }
        .notification-bell .badge { position: absolute; top: -6px; right: -6px; }
        .dropdown-menu-notif { width: 340px; max-height: 60vh; overflow: auto; }
    </style>
</head>

<body class="container py-4">

    {# Compute notifications inside body (before use) #}
    {% set lp = late_payments() %}

    <!-- Top Navbar with Logout on the right -->
    <nav class="navbar navbar-expand-lg bg-light rounded px-3 mb-4">
        <a class="navbar-brand fw-semibold" href="{{ path('app_admin') }}">Gestion Étudiants</a>

        <div class="ms-auto d-flex align-items-center gap-3">

            {# Theme toggle (optional) #}
            <button id="themeToggle" class="btn btn-sm btn-outline-secondary" aria-label="Toggle dark mode">
                🌙
            </button>

            {# Notification bell #}
            <div class="dropdown notification-bell">
                <button class="btn btn-light position-relative" id="notifBell"
                        data-bs-toggle="dropdown" aria-expanded="false">
                    <i class="fas fa-bell"></i>
                    {% if lp|length > 0 %}
                        <span class="badge bg-danger">{{ lp|length }}</span>
                    {% endif %}
                </button>

                <ul class="dropdown-menu dropdown-menu-end dropdown-menu-notif" aria-labelledby="notifBell">
                    <li class="dropdown-header fw-semibold">Notifications</li>

                    {% if lp is empty %}
                        <li><span class="dropdown-item-text text-muted">Aucune notification</span></li>
                    {% else %}
                        {% for p in lp %}
                            {% set displayName = p.displayName
                                |default(p.personnel is defined and p.personnel
                                         ? (p.personnel.nomP|default('') ~ ' ' ~ p.personnel.prenomP|default(''))
                                         : '—') %}
                            <li class="dropdown-item">
                                <div class="d-flex flex-column">
                                    <div>
                                        <strong>{{ displayName|trim }}</strong>
                                        — {{ p.mois|default(p.dateP ? p.dateP|date('F Y') : '') }}
                                    </div>
                                    <small class="text-danger">
                                        {% if p.daysLate is defined %}En retard de {{ p.daysLate }} jours{% else %}En retard{% endif %}
                                    </small>
                                </div>
                            </li>
                        {% endfor %}
                    {% endif %}
                </ul>
            </div>

            {# AUTH AREA: put the LOGOUT button here #}
            {% if app.user %}
                <span class="small text-muted">{{ app.user.userIdentifier }}</span>

                {# POST logout with CSRF (matches csrf_token_id: logout in security.yaml) #}
                <form method="post" action="{{ path('app_logout') }}" class="d-inline">
                    <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
                    <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
                </form>
            {% else %}
                <a class="btn btn-outline-primary btn-sm" href="{{ path('app_login') }}">Login</a>
                <a class="btn btn-primary btn-sm" href="{{ path('app_register') }}">Register</a>
            {% endif %}
        </div>
    </nav>

    {% block body %}{% endblock %}

    <!-- Script: Dark Mode (with null-guards so no error if button removed) -->
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            const toggleButton = document.getElementById("themeToggle");
            const body = document.body;

            const toggleDarkClass = (enabled) => {
                const elementsToToggle = document.querySelectorAll(".card, .table, .navbar, .form-control, .form-select");
                if (enabled) {
                    body.classList.add("dark-mode");
                    elementsToToggle.forEach(el => el.classList.add("dark-mode"));
                    if (toggleButton) toggleButton.textContent = "☀️";
                    localStorage.setItem("theme", "dark");
                } else {
                    body.classList.remove("dark-mode");
                    elementsToToggle.forEach(el => el.classList.remove("dark-mode"));
                    if (toggleButton) toggleButton.textContent = "🌙";
                    localStorage.setItem("theme", "light");
                }
            };

            const savedTheme = localStorage.getItem("theme");
            if (savedTheme === "dark") toggleDarkClass(true);

            if (toggleButton) {
                toggleButton.addEventListener("click", () => {
                    const isDark = body.classList.contains("dark-mode");
                    toggleDarkClass(!isDark);
                });
            }
        });
    </script>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
