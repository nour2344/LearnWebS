{# templates/base.html.twig #}
<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{% block title %}Gestion Étudiants{% endblock %}</title>

  {# ---------- Brand variables (DB -> controller overrides -> defaults) ---------- #}
  {% set setting  = school_setting() %}
  {% set dbName   = setting ? setting.name : null %}
  {% set dbColor  = setting ? setting.primaryColor : null %}
  {% set dbLogo   = setting and setting.logoFilename ? asset('uploads/logos/' ~ setting.logoFilename) : null %}

  {% set schoolName = (school_name is defined and school_name) ? school_name : (dbName ?? 'AdBox Edu') %}
  {% set brandColor = (school_color is defined and school_color) ? school_color : (dbColor ?? '#4a90e2') %}
  {% set logoPath   = (school_logo is defined and school_logo) ? school_logo : dbLogo %}

  {% if logoPath %}
    <link rel="icon" href="{{ logoPath }}">
  {% endif %}
  <meta name="theme-color" content="{{ brandColor }}">

  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
  <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">

  {% block stylesheets %}{% endblock %}

  <style>
    :root { --brand: {{ brandColor }}; }

    body { background-color: #f6f9fc; color: #000; }

    /* Navbar */
    .navbar { border: 1px solid rgba(0,0,0,.06); }
    .brand-dot { display:inline-block; width:28px; height:28px; background:var(--brand); border-radius:6px; }

    /* Right-side brand group */
    .nav-brand-right { display:flex; align-items:center; gap:.5rem; }
    .nav-avatar {
      height: 30px; width: auto; border-radius: 6px;
      box-shadow: 0 2px 10px rgba(0,0,0,.08);
    }
    .school-name-right {
      font-weight: 600;
      max-width: 220px;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    /* Pagination (green theme kept) */
    .pagination .page-item.active .page-link { background-color: #4CAF50; border-color: #4CAF50; color: #fff; }
    .pagination .page-link { color: #4CAF50; }
    .pagination .page-link:hover { background-color: #e6f5e6; }

    /* Notifications */
    .notification-bell { position: relative; }
    .notification-bell .badge { position: absolute; top: -6px; right: -6px; }
    .dropdown-menu-notif { width: 340px; max-height: 60vh; overflow: auto; }

    /* Brand helpers */
    .text-brand{color:var(--brand)!important}
    .border-brand{border-color:var(--brand)!important}
    .bg-brand{background-color:var(--brand)!important;color:#fff}
  </style>
</head>

<body class="py-4">
  {# Show logo + school name ONLY for the admin using admin@gmail.com #}
  {% set show_brand_for_admin =
      app.user
      and is_granted('ROLE_ADMIN')
      and (app.user.userIdentifier ?? app.user.email ?? '') == 'admin@gmail.com'
  %}

  <nav class="navbar navbar-light navbar-expand-lg bg-light rounded px-3 mb-4">
    <div class="container-fluid">

      <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#topNav"
              aria-controls="topNav" aria-expanded="false" aria-label="Menu">
        <span class="navbar-toggler-icon"></span>
      </button>

      <div class="collapse navbar-collapse" id="topNav">
        <ul class="navbar-nav me-auto mb-2 mb-lg-0"></ul>

        <div class="d-flex align-items-center gap-3">

          {# RIGHT: logo + school name (only for that admin) #}
          {% if show_brand_for_admin %}
            <div class="nav-brand-right me-2">
              {% if logoPath %}
                <img class="nav-avatar" src="{{ logoPath }}" alt="{{ schoolName }}">
              {% else %}
                <span class="brand-dot"></span>
              {% endif %}
              <span class="school-name-right">{{ schoolName }}</span>
            </div>
          {% endif %}

          {# Optional admin notifications (also only for that admin) #}
          {% if show_brand_for_admin and late_payments_list is defined %}
            {% set lp = late_payments_list %}
            <div class="dropdown notification-bell">
              <button class="btn btn-light position-relative" id="notifBell" data-bs-toggle="dropdown" aria-expanded="false">
                <i class="fas fa-bell"></i>
                {% if lp|length > 0 %}
                  <span class="badge bg-danger">{{ lp|length }}</span>
                {% endif %}
              </button>

              <ul class="dropdown-menu dropdown-menu-end dropdown-menu-notif" aria-labelledby="notifBell">
                <li class="dropdown-header fw-semibold">Notifications</li>
                {% if lp is empty %}
                  <li><span class="dropdown-item-text text-muted">Aucune notification</span></li>
                {% else %}
                  {% for p in lp %}
                    {% set displayName = p.displayName
                      |default(p.personnel is defined and p.personnel
                        ? (p.personnel.nomP|default('') ~ ' ' ~ p.personnel.prenomP|default(''))
                        : '—') %}
                    <li class="dropdown-item">
                      <div class="d-flex flex-column">
                        <div>
                          <strong>{{ displayName|trim }}</strong>
                          — {{ p.mois|default(p.dateP ? p.dateP|date('F Y') : '') }}
                        </div>
                        <small class="text-danger">
                          {% if p.daysLate is defined %}En retard de {{ p.daysLate }} jours{% else %}En retard{% endif %}
                        </small>
                      </div>
                    </li>
                  {% endfor %}
                {% endif %}
              </ul>
            </div>
          {% endif %}

          {# Auth controls #}
          {% if app.user %}
            <form method="post" action="{{ path('app_logout') }}" class="d-inline">
              <input type="hidden" name="_csrf_token" value="{{ csrf_token('logout') }}">
              <button type="submit" class="btn btn-outline-secondary btn-sm">Logout</button>
            </form>
          {% else %}
            <a class="btn btn-outline-primary btn-sm" href="{{ path('app_login') }}">Login</a>
            <a class="btn btn-primary btn-sm" href="{{ path('app_register') }}">Register</a>
          {% endif %}
        </div>
      </div>
    </div>
  </nav>

  <div class="container">
    {% for label, messages in app.flashes %}
      {% for m in messages %}
        <div class="alert alert-{{ label == 'error' ? 'danger' : (label == 'success' ? 'success' : 'info') }} alert-dismissible fade show" role="alert">
          {{ m }}
          <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
        </div>
      {% endfor %}
    {% endfor %}
  </div>

  <main class="container">
    {% block body %}{% endblock %}
  </main>

  <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
  {% block javascripts %}{% endblock %}
</body>
</html>
