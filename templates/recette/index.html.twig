{% extends 'base_module.html.twig' %}

{% block title %}Liste des Recettes{% endblock %}

{% block module_content %}



<style>
h1 { font-weight: bold; text-align: center; }
  .table thead th, .table td { text-align: center; vertical-align: middle; }
  .btn-icon { display: flex; align-items: center; gap: 5px; }
  .btn-add { background-color: #4caf50; color: white; font-weight: bold; }
  .btn-add:hover { background-color: #43a047; }
  .btn-edit { background-color: #2196f3; color: white; }
  .btn-edit:hover { background-color: #1976d2; }
  .btn-delete { background-color: #e74c3c; color: white; }
  .btn-delete:hover { background-color: #c0392b; }
  .container { animation: fadeIn 0.3s ease-in-out; }
  @keyframes fadeIn { from { opacity:0; transform: translateY(10px);} to { opacity:1; transform: translateY(0);} }


    .table thead th, .table td {
        text-align: center;
        vertical-align: middle;
    }

    .btn-icon {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .btn-add {
        background-color: #4caf50;
        color: white;
        font-weight: bold;
    }

    .btn-add:hover {
        background-color: #43a047;
    }

    .btn-edit {
        background-color: #2196f3;
        color: white;
    }

    .btn-edit:hover {
        background-color: #1976d2;
    }

    .btn-delete {
        background-color: #e74c3c;
        color: white;
    }

    .btn-delete:hover {
        background-color: #c0392b;
    }

    .container {
        animation: fadeIn 0.3s ease-in-out;
    }

    @keyframes fadeIn {
        from { opacity: 0; transform: translateY(10px); }
        to { opacity: 1; transform: translateY(0); }
    }
</style>

<div class="container mt-5">
    <h1 class="mb-4">💵 Liste des Recettes</h1>
  {# 🔎 Filter by Source #}
  <div class="row g-2 align-items-end mb-3">
    <div class="col-sm-4">
      <label for="f_source" class="form-label">Source</label>
      <select id="f_source" name="source" class="form-select">
        <option value="">— Toutes —</option>
        {% for c in sourceChoices %}
          <option value="{{ c.value }}" {{ currentSource == c.value ? 'selected' : '' }}>
            {{ c.label }}
          </option>
        {% endfor %}
      </select>
    </div>
  </div>
    <table class="table table-striped table-bordered shadow-sm">
        <thead class="table-dark">
            <tr>
                <th>🔗 Source</th>
                <th>💰 Montant</th>
                <th>📆 Date</th>
                <th>📝 Note</th>
                <th>⚙️ Actions</th>
            </tr>
        </thead>
         <tbody id="recettes_tbody">
      {% include 'recette/_rows.html.twig' with { recettes: recettes } %}
    </tbody>
  </table>

  <div class="d-flex justify-content-center gap-4 mt-4">
    <a href="{{ path('home') }}" class="btn btn-add btn-lg">⬅️ Accueil</a>
    <a href="{{ path('recette_new') }}" class="btn btn-add btn-lg">➕ Ajouter une recette</a>
  </div>

  <div class="d-flex justify-content-center mt-4">
    {{ knp_pagination_render(recettes) }}
  </div>
</div>

<script>
(function () {
  const sourceEl = document.getElementById('f_source');
  const tbody = document.getElementById('recettes_tbody');

  function fetchRows() {
    const params = new URLSearchParams();
    if (sourceEl.value !== '') params.set('source', sourceEl.value);
    params.set('page', '1'); // reset to page 1 on filter

    fetch('{{ path("recette_index") }}?' + params.toString(), {
      headers: { 'X-Requested-With': 'XMLHttpRequest' }
    })
      .then(r => r.text())
      .then(html => { tbody.innerHTML = html; })
      .catch(console.error);
  }

  sourceEl.addEventListener('change', fetchRows);
})();
</script>
{% endblock %}