{% extends 'base.html.twig' %}

{% block title %}Menu Principal{% endblock %}

{% block body %}
<style>
    body {
        font-family: 'Segoe UI', sans-serif;
        margin: 0;
        padding: 0;
    }

    /* Academic year positioning */
    .academic-year {
        position: absolute;
        top: 20px;
        left: 30px;  
        font-size: 1.2rem;
        font-weight: bold;
        color: #333;
    }
    .welcome-box {
        max-width: 700px;
        background-color: white;
        margin: 40px auto 20px auto;
        padding: 25px 30px;
        border-radius: 20px;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
        text-align: center;
    }

    .welcome-box h2 {
        margin-bottom: 5px;
        font-size: 1.8rem;
        color: #333;
    }

    .welcome-box p {
        font-size: 1rem;
        color: #666;
        margin-top: 0;
    }

    .grid-container {
        display: flex;
        flex-wrap: wrap;
        justify-content: center;
        gap: 30px;
        padding: 30px 50px;
        max-width: 1100px;
        margin: 0 auto;
    }

    .card {
        background: white;
        border-radius: 20px;
        padding: 40px 30px;
        width: 200px;
        height: 200px;
        text-align: center;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
        transition: transform 0.2s ease, box-shadow 0.3s ease;
        cursor: pointer;
        text-decoration: none;
        color: #333;
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
    }

    .card:hover {
        transform: translateY(-6px);
        box-shadow: 0 15px 30px rgba(0, 0, 0, 0.15);
    }

    .card span.icon {
        font-size: 3rem;
        margin-bottom: 12px;
    }

    .card span.text {
        font-size: 1.1rem;
        font-weight: 600;
        letter-spacing: 0.3px;
    }

    @media (max-width: 768px) {
        .grid-container {
            padding: 20px;
        }

        .welcome-box {
            margin: 20px;
        }
    }
    .dashboard-card {
        background-color: #e0f7fa;
        color: #004d40;
        max-width: 400px;
        margin: 30px auto;
        box-shadow: 0 10px 25px rgba(0, 0, 0, 0.15);
    }
</style>

<!-- Academic Year -->
<div class="academic-year">
    {{ "now"|date("Y") }}/{{ ("now"|date("Y") + 1) }}
</div>

<div>
    <a href="{{ path('app_dashboard') }}" class="card dashboard-card">
        <span class="icon">📊</span>
        <span class="text">Tableau de bord administratif</span>
    </a>
</div>

<div class="grid-container">
    <a href="{{ path('etudiant_index') }}" class="card">
        <span class="icon">👨‍🎓</span>
        <span class="text">Étudiants</span>
    </a>

    <a href="{{ path('paiement_index') }}" class="card">
        <span class="icon">💰</span>
        <span class="text">Paiements</span>
    </a>

    <a href="{{ path('personnel_index') }}" class="card">
        <span class="icon">🧑‍🏫</span>
        <span class="text">Personnel</span>
    </a>

    <a href="{{ path('salaire_index') }}" class="card">
        <span class="icon">💵</span>
        <span class="text">Salaires</span>
    </a>

    <a href="{{ path('recette_index') }}" class="card">
        <span class="icon">📥</span>
        <span class="text">Recettes</span>
    </a>

    <a href="{{ path('depense_index') }}" class="card">
        <span class="icon">📤</span>
        <span class="text">Dépenses</span>
    </a>

   {# templates/home/index.html.twig #}
<a href="{{ path('emplois_grille_index') }}" class="card">
  <span class="icon">🗓️</span><span class="text">Emplois (grille)</span>
</a>

<a href="{{ path('emplois_upload_index') }}" class="card">
  <span class="icon">📄</span><span class="text">Emplois (fichier)</span>
</a>
</div>
{% endblock %}