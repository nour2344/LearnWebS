{% for e in emplois %}
  <tr>
    <td>{{ e.classe }}</td>
    <td>{{ e.effectiveFrom ? e.effectiveFrom|date('Y-m-d') : '' }}</td>
    <td>{{ e.titre }}</td>
    <td class="text-nowrap">
      <a class="btn btn-sm btn-info" href="{{ path('emplois_lignes_index', {emploi:e.id}) }}">Gérer les lignes</a>
      <a class="btn btn-sm btn-secondary" href="{{ path('emplois_grille_edit', {id:e.id}) }}">Modifier</a>
      <form method="post" action="{{ path('emplois_grille_delete',{id:e.id}) }}"
            style="display:inline" onsubmit="return confirm('Supprimer ?')">
        <input type="hidden" name="_token" value="{{ csrf_token('del_grille_' ~ e.id) }}">
        <button class="btn btn-sm btn-danger">Supprimer</button>
      </form>
    </td>
  </tr>
{% else %}
  <tr>
    <td colspan="4" class="text-muted">Aucun résultat.</td>
  </tr>
{% endfor %}
