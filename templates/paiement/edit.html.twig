{% extends 'base.html.twig' %}

{% block title %}Modifier Paiement{% endblock %}

{% block body %}
    <h2 class="text-warning mb-4">✏ Modifier le paiement</h2>

    {{ form_start(form) }}
        <div class="row">
            <div class="col-md-6 mb-3">
                {{ form_label(form.typePaiement) }}
                {{ form_widget(form.typePaiement, {'attr': {'class': 'form-select'}}) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_label(form.montantP) }}
                {{ form_widget(form.montantP, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="col-md-6 mb-3">
                {{ form_label(form.dateP) }}
                {{ form_widget(form.dateP, {'attr': {'class': 'form-control'}}) }}
            </div>
           
            <div class="col-md-6 mb-3">
                {{ form_label(form.etudiant) }}
                {{ form_widget(form.etudiant, {'attr': {'class': 'form-select'}}) }}
            </div>
            <div class="col-12 mb-3">
                {{ form_label(form.note) }}
                {{ form_widget(form.note, {'attr': {'class': 'form-control', 'rows': 4}}) }}
            </div>
        </div>

        <button class="btn btn-warning">Mettre à jour</button>
        <a href="{{ path('paiement_index') }}" class="btn btn-secondary">↩ Retour</a>
    {{ form_end(form) }}

    <hr>
{% endblock %}
