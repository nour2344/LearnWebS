<!DOCTYPE html>
<html>
  <head>
    <meta charset="UTF-8">
    <style>
      body { font-family: DejaVu Sans, Arial, sans-serif; font-size: 12px; }
      h2 { margin: 0 0 12px; }
      table { width: 100%; border-collapse: collapse; }
      th, td { border: 1px solid #ccc; padding: 6px 8px; text-align: left; }
      thead th { background: #eee; }
    </style>
  </head>
  <body>
    <h2>Bulletins de {{ etudiant.nom }} {{ etudiant.prenom }}</h2>
    <table>
      <thead>
        <tr>
          <th>Matière</th>
          <th>Note</th>
          <th>Date</th>
          <th>Semestre</th>
        </tr>
      </thead>
      <tbody>
        {% for b in bulletins %}
          <tr>
            <td>{{ b.matiere }}</td>
            <td>{{ b.note }}</td>
            <td>{{ b.date? b.date|date('d/m/Y') }}</td>
            <td>{{ b.semestre }}</td>
          </tr>
        {% else %}
          <tr><td colspan="4">Aucun bulletin.</td></tr>
        {% endfor %}
      </tbody>
    </table>
  </body>
</html>
