{# templates/parent/home.html.twig #}
{% extends 'base.html.twig' %}

{# Safely compute parent/children/child for use everywhere in the file #}
{% set parentProfile = app.user and app.user.parentProfile is defined ? app.user.parentProfile : null %}
{% set children = parentProfile ? parentProfile.children : [] %}
{% set child = children|length ? children|first : null %}

{% block title %}
  Espace Parents{% if child %} — {{ child.nom }} {{ child.prenom }}{% endif %}
{% endblock %}

{% block body %}

  <style>
    :root{
      --brand:#4f46e5;    /* indigo-600 */
      --brand2:#60a5fa;   /* blue-400  */
      --mint:#10b981;     /* emerald   */
      --amber:#f59e0b;    /* amber     */
      --rose:#f43f5e;     /* rose      */
      --bg:#f6f7fb;
      --card:#ffffff;
      --text:#0f172a;     /* slate-900 */
      --muted:#6b7280;    /* gray-500  */
      --border:#e5e7eb;
      --ring: rgba(79,70,229,.18);
    }

    body{ background: var(--bg); }
    .ph-container{ max-width: 1100px; margin: 0 auto; }

    /* Hero */
    .ph-hero{
      position: relative;
      border-radius: 20px;
      overflow: hidden;
      color: #fff;
      padding: 28px;
      background: linear-gradient(115deg, var(--brand), var(--brand2));
      box-shadow: 0 18px 32px rgba(79,70,229,.18);
    }
    .ph-hero .badge{
      background: rgba(255,255,255,.18);
      border: 1px solid rgba(255,255,255,.28);
      color:#fff;
      font-weight: 600;
      padding: 6px 10px;
      border-radius: 999px;
      display:inline-block;
      margin-bottom: 6px;
      backdrop-filter: blur(4px);
    }
    .ph-title{ font-weight: 800; letter-spacing:.2px; }
    .ph-sub{ opacity:.9 }

    /* Cards */
    .ph-card{
      background: var(--card);
      border:1px solid var(--border);
      border-radius: 18px;
      padding: 18px;
      box-shadow: 0 10px 22px rgba(2,6,23,.06);
    }
    .ph-card h6{
      font-weight: 800; letter-spacing:.2px; margin:0 0 8px 0;
      color: var(--text); text-transform: uppercase; font-size: 12px;
    }

    /* Quick links grid */
    .ph-quick{ display:grid; gap:12px; grid-template-columns: repeat(2,minmax(0,1fr)); }
    @media (max-width: 768px){ .ph-quick{ grid-template-columns: 1fr; } }
    .ph-qitem{
      display:flex; align-items:center; gap:12px;
      padding:14px; border-radius:14px; border:1px dashed var(--border); background:#fff;
      transition: .18s ease; text-decoration:none; color: var(--text);
    }
    .ph-qitem:hover{ transform: translateY(-1px); border-style: solid }
    .ph-ico{
      width:36px; height:36px; border-radius:10px; display:grid; place-items:center;
      color:#fff; font-size: 16px;
      box-shadow: 0 10px 20px rgba(2,6,23,.12);
    }
    .bg-mint{ background: var(--mint); }
    .bg-amber{ background: var(--amber); }
    .bg-rose{ background: var(--rose); }
    .bg-indigo{ background: var(--brand); }

    /* Right column */
    .ph-resume .chip{
      display:inline-flex; align-items:center; gap:8px;
      padding:8px 12px; border-radius:999px; background:#f9fafb; border:1px solid var(--border);
      font-weight:600;
    }
    .ph-child{
      display:flex; align-items:center; gap:10px;
      padding:12px; border-radius:14px; border:1px solid var(--border); background:#fff;
    }
    .ph-child .pic{
      width:34px; height:34px; border-radius:50%; display:grid; place-items:center; color:#fff;
      background: linear-gradient(135deg, var(--brand), var(--brand2));
      font-size:14px; font-weight:700;
    }

    /* Empty state */
    .ph-empty{
      border:2px dashed var(--border);
      background: #fff;
      color: var(--muted);
      text-align:center;
      padding:26px;
      border-radius: 16px;
    }
  </style>

  {# --- CHAT WIDGET --------------------------------------------------------- #}
  <style>
    .chat-fab{
      position: fixed; right: 22px; bottom: 22px; z-index: 1050;
      width: 56px; height: 56px; border-radius: 50%;
      display:grid; place-items:center; color:#fff; cursor:pointer;
      background: linear-gradient(135deg,#4f46e5,#60a5fa);
      box-shadow: 0 10px 20px rgba(2,6,23,.18);
    }
    .chat-panel{
      position: fixed; right: 22px; bottom: 90px; z-index: 1050;
      width: 340px; max-height: 70vh; display:none; flex-direction:column;
      background:#fff; border:1px solid #e5e7eb; border-radius:18px;
      box-shadow: 0 18px 36px rgba(2,6,23,.18); overflow:hidden;
      opacity:0; transform: translateY(8px);
      transition: opacity .18s ease, transform .18s ease;
    }
    .chat-panel.open{ display:flex; opacity:1; transform:none; }
    .chat-header{ padding:12px 14px; background:linear-gradient(115deg,#4f46e5,#60a5fa); color:#fff; }
    .chat-body{ padding:12px; overflow:auto; display:flex; flex-direction:column; gap:10px; }
    .chat-msg{ padding:10px 12px; border-radius:12px; max-width: 80%; }
    .chat-msg.me{ background:#eef2ff; align-self:flex-end; }
    .chat-msg.bot{ background:#f8fafc; border:1px solid #e5e7eb; align-self:flex-start; }
    .chat-suggestions{ display:flex; flex-wrap:wrap; gap:6px; margin-top:6px; }
    .chat-suggestions button{
      border:1px solid #e5e7eb; background:#fff; border-radius:999px; padding:6px 10px; font-size:12px;
    }
    .chat-input{ display:flex; gap:6px; padding:10px; border-top:1px solid #e5e7eb; }
    .chat-input input{ flex:1; border:1px solid #e5e7eb; border-radius:10px; padding:8px 10px; }
  </style>

  <div id="chatFab" class="chat-fab" title="Discuter">
    <i class="fa-solid fa-message"></i>
  </div>

  <div id="chatPanel" class="chat-panel" aria-hidden="true">
    <div class="chat-header d-flex align-items-center justify-content-between">
      <div><i class="fa-solid fa-robot me-1"></i> Assistant Parents</div>
      <button class="btn btn-sm btn-light" id="chatClose" type="button">×</button>
    </div>
    <div id="chatBody" class="chat-body">
      <div class="chat-msg bot">
        Bonjour 👋 Je peux vous aider sur les horaires, paiements, bulletins, emploi du temps, etc.
      </div>
    </div>
    <div class="chat-input">
      <input id="chatInput" type="text" placeholder="Saisissez votre question…" />
      <button id="chatSend" class="btn btn-primary" type="button">Envoyer</button>
    </div>
  </div>
  {# --- END CHAT WIDGET ----------------------------------------------------- #}

  <div class="ph-container">

    {# ===== HERO (no actions) ===== #}
    <div class="ph-hero mb-3">
      <span class="badge"><i class="fa-solid fa-shield-heart me-1"></i>Espace Parents</span>
      <div class="d-flex align-items-start gap-3 flex-wrap">
        <div>
          <h1 class="h3 ph-title mb-1">
            Bonjour{% if app.user and app.user.firstname is defined %} {{ app.user.firstname }}{% endif %} 👋
          </h1>
          <div class="ph-sub">
            {% if child %}
              Suivi de <strong>{{ child.nom }} {{ child.prenom }}</strong>
            {% else %}
              Associez votre/vos enfant(s) pour commencer.
            {% endif %}
          </div>
        </div>

        {% if children|length > 1 %}
          <div class="ms-auto" style="min-width:260px;">
            <label class="text-white-50 small mb-1">Basculer d’élève</label>
            <select id="child-switch" class="form-select"
                    onchange="if(this.value){ window.location.href=this.value; }">
              <option value="">Choisir un élève…</option>
              {% for c in children %}
                <option value="{{ path('parent_fiche', {'id': c.id}) }}">
                  {{ c.nom }} {{ c.prenom }}{% if c.classe is defined %} — {{ c.classe }}{% endif %}
                </option>
              {% endfor %}
            </select>
          </div>
        {% endif %}
      </div>
    </div>

    <div class="row g-3">
      {# ===== LEFT: QUICK LINKS ===== #}
      <div class="col-12 col-lg-8">
        <div class="ph-card mb-3">
          <h6>Accès rapide</h6>
          <div class="ph-quick">
            <a class="ph-qitem" href="{{ path('parent_bulletins') }}">
              <div class="ph-ico bg-indigo"><i class="fa-regular fa-file-lines"></i></div>
              <div>
                <div class="fw-bold">Consulter les bulletins</div>
                <div class="text-muted small">Notes et appréciations trimestrielles</div>
              </div>
            </a>

            <a class="ph-qitem" href="{{ path('parent_emplois_index', child ? {'child': child.id} : {}) }}">
              <div class="ph-ico bg-amber"><i class="fa-regular fa-calendar"></i></div>
              <div>
                <div class="fw-bold">Emploi du temps</div>
                <div class="text-muted small">Cours, salles et horaires à jour</div>
              </div>
            </a>

            <a class="ph-qitem" href="{{ path('parent_emplois_pdf', child ? {'child': child.id} : {}) }}" target="_blank" rel="noopener">
              <div class="ph-ico bg-mint"><i class="fa-solid fa-download"></i></div>
              <div>
                <div class="fw-bold">Télécharger en PDF</div>
                <div class="text-muted small">Version imprimable de l’emploi du temps</div>
              </div>
            </a>

            {% if child %}
              <a class="ph-qitem" href="{{ path('parent_fiche', {'id': child.id}) }}">
                <div class="ph-ico bg-rose"><i class="fa-regular fa-id-card"></i></div>
                <div>
                  <div class="fw-bold">Fiche élève</div>
                  <div class="text-muted small">Infos & état des paiements</div>
                </div>
              </a>
            {% else %}
              <div class="ph-qitem" style="opacity:.7; pointer-events:none;">
                <div class="ph-ico bg-rose"><i class="fa-regular fa-id-card"></i></div>
                <div>
                  <div class="fw-bold">Fiche élève</div>
                  <div class="text-muted small">Disponible après association d’un élève</div>
                </div>
              </div>
            {% endif %}
          </div>
        </div>

        {% if not child %}
          <div class="ph-empty">
            <i class="fa-solid fa-circle-info me-2"></i>
            Aucun enfant associé à ce compte. Contactez l’administration pour lier votre profil parent.
          </div>
        {% endif %}
      </div>

      {# ===== RIGHT: RESUME + CHILDREN ===== #}
      <div class="col-12 col-lg-4">
        <div class="ph-card ph-resume">
          <h6>Résumé</h6>
          <div class="mb-2"><span class="chip"><i class="fa-solid fa-children"></i>&nbsp; {{ children|length }} enfant(s)</span></div>

          {% if children|length >= 1 %}
            <div class="mt-3 mb-2 text-muted small">Élève(s) lié(s)</div>
            <div class="d-flex flex-column gap-2">
              {% for c in children %}
                <div class="ph-child">
                  <div class="pic">{{ c.prenom|first|upper }}</div>
                  <div class="flex-grow-1">
                    <div class="fw-semibold">{{ c.nom }} {{ c.prenom }}</div>
                    {% if c.classe is defined %}
                      <div class="text-muted small">{{ c.classe }}</div>
                    {% endif %}
                  </div>
                  <div class="dropdown">
                    <button class="btn btn-sm btn-outline-primary dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                      Ouvrir
                    </button>
                    <ul class="dropdown-menu dropdown-menu-end">
                      <li><a class="dropdown-item" href="{{ path('parent_fiche', {'id': c.id}) }}"><i class="fa-regular fa-id-card me-2"></i>Fiche élève</a></li>
                      <li><a class="dropdown-item" href="{{ path('parent_emplois_index', {'child': c.id}) }}"><i class="fa-regular fa-calendar me-2"></i>Emploi du temps</a></li>
                      <li><a class="dropdown-item" target="_blank" rel="noopener" href="{{ path('parent_emplois_pdf', {'child': c.id}) }}"><i class="fa-solid fa-download me-2"></i>PDF emploi du temps</a></li>
                    </ul>
                  </div>
                </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>

  <script>
    // Runs after DOM is ready
    document.addEventListener('DOMContentLoaded', function(){
      // Child switcher preselect if we are on /parent/fiche/{id}
      const sel = document.getElementById('child-switch');
      if (sel) {
        try{
          const m = (new URL(location.href)).pathname.match(/\/parent\/fiche\/(\d+)/);
          if(m && m[1]) { for(const opt of sel.options){ if(opt.value.endsWith('/'+m[1])) opt.selected = true; } }
        }catch(e){}
      }

      // --- Chat widget wiring
      const fab = document.getElementById('chatFab');
      const panel = document.getElementById('chatPanel');
      const closeBtn = document.getElementById('chatClose');
      const bodyEl = document.getElementById('chatBody');
      const input = document.getElementById('chatInput');
      const send = document.getElementById('chatSend');

      if (fab && panel && bodyEl && input && send) {
        const openPanel = ()=>{ panel.classList.add('open'); panel.setAttribute('aria-hidden','false'); input.focus(); };
        const closePanel = ()=>{ panel.classList.remove('open'); panel.setAttribute('aria-hidden','true'); };
        fab.addEventListener('click', openPanel);
        closeBtn?.addEventListener('click', closePanel);

        let typingEl = null;
        const showTyping = ()=>{
          if(typingEl) return;
          typingEl = document.createElement('div');
          typingEl.className = 'chat-msg bot';
          typingEl.textContent = '…';
          bodyEl.appendChild(typingEl);
          bodyEl.scrollTop = bodyEl.scrollHeight;
        };
        const hideTyping = ()=>{ if(typingEl){ typingEl.remove(); typingEl=null; } };

        const addMessage = (html, who='bot', suggestions=[])=>{
          const msg = document.createElement('div');
          msg.className = 'chat-msg ' + who;
          msg.innerHTML = html;
          bodyEl.appendChild(msg);

          if(who==='bot' && suggestions.length){
            const wrap = document.createElement('div');
            wrap.className = 'chat-suggestions';
            suggestions.forEach(s => {
              const b = document.createElement('button');
              b.type = 'button';
              b.textContent = s;
              b.addEventListener('click', ()=> sendMessage(s));
              wrap.appendChild(b);
            });
            bodyEl.appendChild(wrap);
          }
          bodyEl.scrollTop = bodyEl.scrollHeight;
        };

        const sendMessage = async (text)=>{
          if(!text.trim()) return;
          addMessage(text, 'me');
          input.value = '';
          showTyping();
          try{
            const r = await fetch('{{ path('api_parent_chat') }}', {
              method:'POST',
              headers: {'Content-Type':'application/json'},
              body: JSON.stringify({ message: text })
            });
            const data = await r.json();
            hideTyping();
            if (r.status === 403) {
              addMessage("Veuillez vous reconnecter en tant que parent pour utiliser le chat.", 'bot');
              return;
            }
            addMessage(data.reply || "Désolé, je n'ai pas compris.", 'bot', data.suggestions || []);
          }catch(e){
            hideTyping();
            addMessage("Une erreur s'est produite. Réessayez plus tard.", 'bot');
            console.error('[chat] fetch error', e);
          }
        };

        send.addEventListener('click', ()=> sendMessage(input.value));
        input.addEventListener('keydown', (e)=>{ if(e.key==='Enter'){ sendMessage(input.value); }});
      }
    });
  </script>

{% endblock %}
