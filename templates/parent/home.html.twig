{# templates/parent/home.html.twig #}
{% extends 'base.html.twig' %}

{# Safely compute parent/children/child for use everywhere in the file #}
{% set parentProfile = app.user and app.user.parentProfile is defined ? app.user.parentProfile : null %}
{% set children = parentProfile ? parentProfile.children : [] %}
{% set child = children|length ? children|first : null %}

{% block title %}
  Espace Parents{% if child %} — {{ child.nom }} {{ child.prenom }}{% endif %}
{% endblock %}

{% block body %}
  <div class="row g-3">
    <div class="col-12 col-lg-8">
      <div class="p-4 bg-white rounded-4 shadow-sm">
        <h1 class="h3 mb-2">
          Espace Parents
          {% if child %}<small class="text-muted">— {{ child.nom }} {{ child.prenom }}</small>{% endif %}
        </h1>
        <p class="text-muted mb-4">Consultez les bulletins et l’emploi du temps de vos enfants.</p>

        <div class="d-flex gap-2">
          <a class="btn btn-primary" href="{{ path('parent_bulletins') }}">
            <i class="fa-regular fa-file-lines me-1"></i> Voir les bulletins
          </a>

          {# Emploi du temps (use first child’s class by default) #}
          <a class="btn btn-outline-primary"
             href="{{ path('parent_emplois_index', child ? {'child': child.id} : {}) }}">
            <i class="fa-regular fa-calendar me-1"></i> Voir l’emploi du temps
          </a>

          <a class="btn btn-outline-secondary"
             href="{{ path('parent_emplois_pdf', child ? {'child': child.id} : {}) }}"
             target="_blank">
            <i class="fa-solid fa-download me-1"></i> Télécharger PDF
          </a>
        </div>
      </div>
    </div>

    <div class="col-12 col-lg-4">
      <div class="p-4 bg-white rounded-4 shadow-sm">
        <div class="small text-muted mb-2">Résumé</div>

        <div class="d-flex flex-column gap-2">
          <div>
            <i class="fa-solid fa-children me-2"></i>{{ children|length }} enfant(s)
          </div>

          {% if children|length == 1 %}
            <div><i class="fa-solid fa-user me-2"></i> Élève : {{ child.nom }} {{ child.prenom }}</div>
            {% if child.classe is defined %}
              <div><i class="fa-solid fa-school me-2"></i> Classe : {{ child.classe }}</div>
            {% endif %}
          {% elseif children|length > 1 %}
            {% for c in children %}
              <div>
                <i class="fa-solid fa-user me-2"></i>
                {{ c.nom }} {{ c.prenom }}
                {% if c.classe is defined %}
                  <span class="text-muted">— {{ c.classe }}</span>
                {% endif %}
              </div>
            {% endfor %}
          {% else %}
            <div class="text-muted fst-italic">Aucun enfant associé à ce compte.</div>
          {% endif %}
        </div>
      </div>
    </div>
  </div>
{% endblock %}
